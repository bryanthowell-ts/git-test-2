obj_id: agentGenerated_IllinoisSalesPerformanceRADAnalysis-b10a494d
liveboard:
  name: agentGenerated_Illinois Sales Performance RAD Analysis
  visualizations:
  - id: Viz_1
    viz_guid: 991563aa-05e1-4aea-9153-651aba6966c2
    note_tile:
      html_parsed_string: |-
        Key Drivers:
        • Illinois showing 80,166 in sales but -12,608 profit (-15.7% margin)
        • Furniture category losing -9,076 with -32.1% margin, Office Supplies losing -8,354 with -42% margin
        • All customer segments unprofitable: Consumer (-5,471), Corporate (-4,493), Home Office (-2,644)
        • Chicago dominates with 60.6% of state sales at 48,540

        Recommendations:
        • Focus growth on Technology category (only profitable at +15.1% margin)
        • Review pricing strategy for Furniture and Office Supplies or discontinue worst performers
        • Analyze Chicago market for profitability opportunities given volume concentration
  - id: Viz_2
    answer:
      name: Top 10 Sub Category by total Sales where State is Illinois
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      search_query: "top 10 [Sub Category] [State] = 'illinois' sort by [Sales]"
      answer_columns:
      - name: Sub Category
      - name: Total Sales
      table:
        table_columns:
        - column_id: Sub Category
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Sales
          headline_aggregation: SUM
        ordered_column_ids:
        - Sub Category
        - Total Sales
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Sub Category\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}}]}"
