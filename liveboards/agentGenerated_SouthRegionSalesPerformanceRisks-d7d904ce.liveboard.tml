obj_id: agentGenerated_SouthRegionSalesPerformanceRisks-d7d904ce
liveboard:
  name: agentGenerated_South Region Sales Performance Risks
  visualizations:
  - id: Viz_1
    viz_guid: 84710b6d-de95-487e-ac11-3360dd7d1d75
    note_tile:
      html_parsed_string: |-
        Key Drivers:
        • South region underperforms by 46% in sales vs West region (391K vs 725K)
        • Tables sub-category losing $4,623 profit on $43,916 sales (-11% margin)
        • Furniture category shows dangerously low 5.8% profit margin
        • Two sub-categories (Tables, Machines) generating significant losses despite high sales volume

        Recommendations:
        • Discontinue or restructure Tables product line to eliminate $4,623 loss
        • Investigate Furniture category pricing and cost structure to improve 5.8% margins
        • Increase market penetration efforts in South region to close 49% order count gap
  - id: Viz_2
    answer:
      name: Bottom 10 products by Profit where Region is South to identify loss-making products
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      search_query: "bottom 10 [Product Name] [Region] = 'south' sort by [Profit]"
      answer_columns:
      - name: Product Name
      - name: Total Profit
      table:
        table_columns:
        - column_id: Product Name
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Profit
          headline_aggregation: SUM
        ordered_column_ids:
        - Product Name
        - Total Profit
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Product Name\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}}]}"
      chart:
        type: BAR
        chart_columns:
        - column_id: Product Name
        - column_id: Total Profit
        axis_configs:
        - x:
          - Product Name
          "y":
          - Total Profit
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"Product Name\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"8a6ddefa-c0be-4584-b0b5-49f1322a9a59\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Profit\"],\"isOpposite\": false}},{\"id\": \"21cddfb6-b52f-4384-9db3-d09e02f9ee49\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Product Name\"]}}]}"
      display_mode: CHART_MODE
    viz_guid: 0993f304-4412-45d7-aac3-55133c87ba48
