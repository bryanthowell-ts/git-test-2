obj_id: agentGenerated_ArizonaSalesPerformanceAnalysisDashboard-a3ba5c7d
liveboard:
  name: agentGenerated_Arizona Sales Performance Analysis Dashboard
  visualizations:
  - id: Viz_1
    viz_guid: 170fa977-05f2-4330-9319-cfbaf1e39873
    note_tile:
      html_parsed_string: |-
        Key Drivers:
        • Excessive discount rate of 30.4% driving negative profitability despite $35,282 in sales
        • Furniture category losing $2,745 with -20.3% margin while generating highest sales volume
        • All customer segments (Consumer, Corporate, Home Office) operating at losses
        • Office Supplies category also unprofitable with -8.0% margin

        Recommendations:
        • Immediately reduce discount rates, particularly in Furniture category
        • Reassess Furniture pricing strategy and product mix to restore profitability
        • Focus sales efforts on Technology products which show positive 1.0% margins
  - id: Viz_2
    answer:
      name: Sales and Profit by Category where State is Arizona
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      search_query: "[Sales] [Profit] [Category] [State] = 'arizona'"
      answer_columns:
      - name: Category
      - name: Total Profit
      - name: Total Sales
      table:
        table_columns:
        - column_id: Category
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Profit
          headline_aggregation: SUM
        - column_id: Total Sales
          headline_aggregation: SUM
        ordered_column_ids:
        - Category
        - Total Sales
        - Total Profit
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Category\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}}]}"
      chart:
        type: BAR
        chart_columns:
        - column_id: Category
        - column_id: Total Profit
        - column_id: Total Sales
        axis_configs:
        - x:
          - Category
          "y":
          - Total Sales
          - Total Profit
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"Category\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"2edb9d4c-2cfd-4e3d-a5fe-c676b33ffc0b\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Sales\"],\"isOpposite\": false}},{\"id\": \"5ea9fd03-4efd-48bc-88d9-608fc3c6ed2a\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Profit\"],\"isOpposite\": true}},{\"id\": \"3e29502c-6468-4090-91ff-5532dd555d8b\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Category\"]}}]}"
