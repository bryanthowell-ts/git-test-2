obj_id: agentGenerated_RegionalSalesRiskProfitabilityAnalysis-70ea048a
liveboard:
  name: agentGenerated_Regional Sales Risk Profitability Analysis
  visualizations:
  - id: Viz_1
    viz_guid: f7abef67-a57c-4080-8737-76e16fa1bd66
    note_tile:
      html_parsed_string: "Key Drivers:\n• Central region shows critical profitability risk with only 7.9% margin vs 15% in West region\n• Furniture category in Central operates at $2,871 loss - the only category-region combination losing money  \n• Central region applies highest average discounts at 24% while achieving lowest profit conversion\n• Despite second-highest sales volume, Central converts sales to profit at nearly half the rate of top performers\n\nRecommendations:\n• Immediately investigate and restructure furniture operations in Central region to eliminate losses\n• Reduce discount levels in Central region and implement margin-focused pricing strategy\n• Conduct deep-dive analysis of Central region cost structure and operational inefficiencies"
  - id: Viz_2
    answer:
      name: "Total Sales and Total Profit by Region and Category, sorted by Profit ascending"
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      search_query: "[Sales] [Profit] [Category] [Region] sort by [Profit] ascending"
      answer_columns:
      - name: Category
      - name: Region
      - name: Total Profit
        sort_info:
          category: DEFAULT
      - name: Total Sales
      table:
        table_columns:
        - column_id: Category
          headline_aggregation: COUNT_DISTINCT
        - column_id: Region
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Profit
          headline_aggregation: SUM
        - column_id: Total Sales
          headline_aggregation: SUM
        ordered_column_ids:
        - Category
        - Region
        - Total Sales
        - Total Profit
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Category\",\"columnProperty\": {}},{\"columnId\": \"Region\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}}]}"
      chart:
        type: ADVANCED_LINE_STACKED_COLUMN
        chart_columns:
        - column_id: Category
        - column_id: Region
        - column_id: Total Profit
        - column_id: Total Sales
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"Total Sales\",\"columnProperty\": {}},{\"columnId\": \"Region\",\"columnProperty\": {}},{\"columnId\": \"Category\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"480b8b3b-48fd-4b4b-9cbb-9dc925b893a1\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Sales\"],\"isOpposite\": false}},{\"id\": \"502bb4ac-ebf0-4c2a-ba79-0f321bb1937a\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Profit\"],\"isOpposite\": true}},{\"id\": \"f7760ec9-0159-4ba2-b8f6-ba9e624adce1\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Category\"]}}]}"
