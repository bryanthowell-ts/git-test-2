obj_id: agentGenerated_SouthRegionSalesPerformanceRisks-12b7d0e0
liveboard:
  name: agentGenerated_South Region Sales Performance Risks
  visualizations:
  - id: Viz_1
    viz_guid: 9dcc2d48-81d6-44b3-811f-89535847857a
    note_tile:
      html_parsed_string: |-
        Key Drivers:
        • Tables sub-category losing $4,623 profit despite $43,916 in sales with 22.3% average discount
        • Machines sub-category has highest discount rate at 33.3%, generating $1,439 loss
        • Top 10 loss-making products causing over $14,500 in cumulative losses
        • South region underperforms with lowest sales ($391,722) and 11.9% profit margin vs other regions

        Recommendations:
        • Immediately review pricing strategy for Tables and reduce discounting on Machines below 25%
        • Discontinue or reprices the 5 highest-loss products saving $11,802 annually
  - id: Viz_2
    answer:
      name: "Show sum of Sales, sum of Profit by Region"
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      search_query: "[Sales] [Profit] [Region]"
      answer_columns:
      - name: Region
      - name: Total Profit
      - name: Total Sales
      table:
        table_columns:
        - column_id: Region
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Profit
          headline_aggregation: SUM
        - column_id: Total Sales
          headline_aggregation: SUM
        ordered_column_ids:
        - Region
        - Total Sales
        - Total Profit
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Region\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}}]}"
      chart:
        type: ADVANCED_COLUMN
        chart_columns:
        - column_id: Region
        - column_id: Total Profit
        - column_id: Total Sales
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"Region\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"8eb59bdc-75aa-4150-9060-dc20c5a88d36\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Sales\"],\"isOpposite\": false}},{\"id\": \"417e61dc-e14a-4ad2-a5fb-2e5e0d181af5\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Profit\"],\"isOpposite\": true}},{\"id\": \"9b96cc8a-7019-45ae-8ee3-79754db47616\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Region\"]}}]}"
        custom_chart_config:
        - key: basic
          dimensions:
          - key: x-axis
