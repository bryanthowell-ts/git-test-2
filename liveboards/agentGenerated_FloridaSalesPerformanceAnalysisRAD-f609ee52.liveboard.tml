obj_id: agentGenerated_FloridaSalesPerformanceAnalysisRAD-f609ee52
liveboard:
  name: agentGenerated_Florida Sales Performance Analysis RAD
  visualizations:
  - id: Viz_1
    viz_guid: 7f0af520-ce08-48b4-bebb-551872949b8a
    note_tile:
      html_parsed_string: |-
        Key Drivers:
        • High discount rate of 29.9% severely impacting profitability, resulting in net loss of $3,399 despite $89,474 in sales
        • Furniture category losing $2,255 (-9.8% margin) and Office Supplies losing $1,675 (-8.6% margin)
        • Jacksonville dominates with 44% of Florida sales but profitability issues persist statewide
        • Technology category is only profitable segment with $531 profit

        Recommendations:
        • Reduce discount rates immediately, especially in Furniture and Office Supplies categories
        • Focus growth investments on Technology category which shows positive margins
        • Investigate Jacksonville market specifically given its sales dominance but overall state losses
  - id: Viz_2
    answer:
      name: Sales and Profit by Category where State is Florida
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      search_query: "[Sales] [Profit] [Category] [State] = 'florida'"
      answer_columns:
      - name: Category
      - name: Total Profit
      - name: Total Sales
      table:
        table_columns:
        - column_id: Category
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Profit
          headline_aggregation: SUM
        - column_id: Total Sales
          headline_aggregation: SUM
        ordered_column_ids:
        - Category
        - Total Sales
        - Total Profit
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Category\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}}]}"
      chart:
        type: ADVANCED_COLUMN
        chart_columns:
        - column_id: Category
        - column_id: Total Profit
        - column_id: Total Sales
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"Total Profit\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}},{\"columnId\": \"Category\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"44628d31-137b-46bb-9126-6095d19f74db\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Sales\"],\"isOpposite\": false}},{\"id\": \"25c97378-5755-4b5c-b67a-301e6b6ef4fe\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Profit\"],\"isOpposite\": true}},{\"id\": \"8b824628-75dc-4558-9349-9a69f21dfc93\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Category\"]}}]}"
        custom_chart_config:
        - key: basic
          dimensions:
          - key: x-axis
            axes:
            - type: FLAT
              column: Category
            mode: AXIS_DRIVEN
          - key: y-axis
