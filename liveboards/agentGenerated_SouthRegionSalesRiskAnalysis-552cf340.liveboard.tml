obj_id: agentGenerated_SouthRegionSalesRiskAnalysis-552cf340
liveboard:
  name: agentGenerated_South Region Sales Risk Analysis
  visualizations:
  - id: Viz_1
    viz_guid: 0ee1b2ad-f64f-4350-b3c1-7324358dd5a0
    note_tile:
      html_parsed_string: |-
        Key Drivers:
        • 2024 profit declined 50% despite highest sales (122,906) due to margin compression from 18.9% to 7.2%
        • Tables (-4,623 profit) and Machines (-1,438 profit) sub-categories losing money consistently
        • Recent months show losses: Oct 2024 (-2,243) and Nov 2024 (-1,624) indicating Q4 seasonal risk pattern
        • High-discount products (40-70% discounts) generating massive losses while South ranks 2nd lowest in regional profit

        Recommendations:
        • Immediately review pricing strategy for Tables and Machines categories to restore profitability
        • Implement discount controls and approval processes for discounts above 30%
        • Focus Q4 planning on addressing seasonal loss patterns in Oct-Nov timeframe
  - id: Viz_2
    answer:
      name: "Total Sales, Total Profit by Region sorted by Profit ascending"
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      search_query: "sum [Sales] sum [Profit] [Region] sort by [Profit] ascending"
      answer_columns:
      - name: Region
      - name: Total Profit
        sort_info:
          category: DEFAULT
      - name: Total Sales
      table:
        table_columns:
        - column_id: Region
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Profit
          headline_aggregation: SUM
        - column_id: Total Sales
          headline_aggregation: SUM
        ordered_column_ids:
        - Region
        - Total Sales
        - Total Profit
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Region\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}}]}"
      chart:
        type: BAR
        chart_columns:
        - column_id: Region
        - column_id: Total Profit
        - column_id: Total Sales
        axis_configs:
        - x:
          - Region
          "y":
          - Total Sales
          - Total Profit
        client_state: ""
