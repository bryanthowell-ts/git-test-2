obj_id: agentGenerated_SouthRegionSalesPerformanceRisks-91cc87dc
liveboard:
  name: agentGenerated_South Region Sales Performance Risks
  visualizations:
  - id: Viz_1
    viz_guid: aedaef64-0d84-4e3e-a4a1-74a253edda73
    note_tile:
      html_parsed_string: |-
        Key Drivers:
        • South region generates lowest sales (391,722) and profit (46,749), performing 46% and 57% below top region respectively
        • Florida operates at a loss (-$3,399) with excessive 29.9% average discount rate
        • Tables, Binders, and Machines sub-categories lose ~$25,000 combined
        • Furniture category has dangerously low 5.8% profit margin vs 13-16% for other categories

        Recommendations:
        • Immediately review pricing strategy for Tables, Binders, and Machines to eliminate losses
        • Reduce Florida discount rates from 29.9% to regional average of 14.7%
        • Focus sales efforts on higher-margin Technology and Office Supplies categories
  - id: Viz_2
    answer:
      name: "Sum of Sales, Sum of Profit, and Average Discount by Category where Region is South"
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      search_query: "sum [Sales] sum [Profit] average [Discount] [Category] [Region] = 'south'"
      answer_columns:
      - name: Average Discount
      - name: Category
      - name: Total Profit
      - name: Total Sales
      table:
        table_columns:
        - column_id: Average Discount
          headline_aggregation: TABLE_AGGR
        - column_id: Category
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Profit
          headline_aggregation: SUM
        - column_id: Total Sales
          headline_aggregation: SUM
        ordered_column_ids:
        - Category
        - Total Sales
        - Total Profit
        - Average Discount
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Category\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}},{\"columnId\": \"Average Discount\",\"columnProperty\": {}}]}"
