obj_id: BannerTest4-52fb9a4a
liveboard:
  name: Banner Test 4
  visualizations:
  - id: Viz_1
    viz_guid: 67ec2e02-f5dc-4d68-a43e-3574a5deabd5
    note_tile:
      html_parsed_string: |-
        Key Drivers:
        • Central region offers 24% average discounts vs 11% in West - over 2x higher discount rates destroying profit margins
        • Furniture category loses $2,871 in Central region with -1.8% margin due to excessive 29.7% discounting
        • West region achieves 14.9% profit margin vs Central's 7.9% margin despite similar product mix

        Recommendations:
        • Implement discount approval controls in Central region to cap discounts at 15% maximum
        • Review furniture pricing strategy in Central - reduce discounts from 29.7% to under 20%
  - id: Viz_2
    answer:
