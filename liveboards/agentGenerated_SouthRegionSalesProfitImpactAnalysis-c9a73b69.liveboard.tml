  - id: Viz_6
    answer:
      name: Top 5 and bottom 5 Sub Category by Profit where Region is South
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      formulas:
      - id: formula_top or bottom 5
        name: top or bottom 5
        expr: "if ( [formula_rank descending] <= 5 or [formula_rank ascending] <= 5 ) then 'true' else 'false'"
        was_auto_generated: false
      - id: formula_rank ascending
        name: rank ascending
        expr: "rank ( sum ( [Profit] ) , 'asc' )"
        was_auto_generated: false
      - id: formula_rank descending
        name: rank descending
        expr: "rank ( sum ( [Profit] ) , 'desc' )"
        was_auto_generated: false
      search_query: "[Profit] [Sub Category] [Region] = 'south' [formula_top or bottom 5] = 'true' sort by [Profit] descending"
      answer_columns:
      - name: Sub Category
      - name: Total Profit
        sort_info:
          category: DEFAULT
      table:
        table_columns:
        - column_id: Sub Category
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Profit
          headline_aggregation: SUM
        ordered_column_ids:
        - Sub Category
        - Total Profit
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Sub Category\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}}]}"
      chart:
