obj_id: agentGenerated_SouthRegionSalesProfitImpactAnalysis-c9a73b69
liveboard:
  name: agentGenerated_South Region Sales Profit Impact Analysis
  visualizations:
  - id: Viz_1
    viz_guid: 6987eeb7-5ba0-4de1-bbb4-75bbfad729f7
    note_tile:
      html_parsed_string: |-
        Key Drivers:
        • Tables sub-category generates $43,916 in sales but loses $4,623 in profit
        • Machines sub-category has highest discount rate at 33.3%, resulting in $1,439 loss
        • Home Office segment shows significantly lower profit margin at 6.2% vs 13.8% for Consumer
        • Technology products (Phones, Accessories) drive highest profits with low 9-10% discount rates

        Recommendations:
        • Reduce discounting on Machines from 33.3% and reassess Tables pricing strategy
        • Focus sales efforts on profitable Technology items and Consumer segment
        • Investigate Home Office segment pricing to improve 6.2% margin
  - id: Viz_2
    answer:
      name: Sales and Profit by Category and Sub Category where Region is South
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      search_query: "[Sales] [Profit] [Sub Category] [Category] [Region] = 'south'"
      answer_columns:
      - name: Category
      - name: Sub Category
      - name: Total Profit
      - name: Total Sales
      table:
        table_columns:
        - column_id: Category
          headline_aggregation: COUNT_DISTINCT
        - column_id: Sub Category
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Profit
          headline_aggregation: SUM
        - column_id: Total Sales
          headline_aggregation: SUM
        ordered_column_ids:
        - Sub Category
        - Category
        - Total Sales
        - Total Profit
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Sub Category\",\"columnProperty\": {}},{\"columnId\": \"Category\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}}]}"
      chart:
        type: ADVANCED_LINE_STACKED_COLUMN
        chart_columns:
        - column_id: Category
        - column_id: Sub Category
        - column_id: Total Profit
        - column_id: Total Sales
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"Total Sales\",\"columnProperty\": {}},{\"columnId\": \"Category\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}},{\"columnId\": \"Sub Category\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"699d2f99-3a40-4074-af0e-46d4ed38f7ba\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Sales\"],\"isOpposite\": false}},{\"id\": \"5b0888cc-81b4-446b-a8e2-684974a109e9\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Profit\"],\"isOpposite\": true}},{\"id\": \"339e7617-ecc6-4d33-9237-eec5a304600b\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Sub Category\"]}}]}"
        custom_chart_config:
        - key: basic
