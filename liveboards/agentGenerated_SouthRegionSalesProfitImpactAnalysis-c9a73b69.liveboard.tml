              columns:
              - Total Profit
            mode: AXIS_DRIVEN
          - key: slice-with-color
            mode: AXIS_DRIVEN
          - key: trellis-by
            mode: AXIS_DRIVEN
      display_mode: TABLE_MODE
    viz_guid: 5c134107-699a-416c-a2bf-108fcd7180c1
  - id: Viz_3
