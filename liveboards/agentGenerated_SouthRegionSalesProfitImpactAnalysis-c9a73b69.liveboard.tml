        name: RAD Superstore
        obj_id: RADSuperstoreProd
      search_query: "average [Discount] [Sales] [Profit] [Sub Category] [Region] = 'south' sort by [Profit]"
      answer_columns:
      - name: Average Discount
      - name: Sub Category
      - name: Total Profit
        sort_info:
          category: DEFAULT
      - name: Total Sales
