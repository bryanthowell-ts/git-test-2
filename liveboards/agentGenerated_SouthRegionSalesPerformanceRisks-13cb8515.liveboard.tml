obj_id: agentGenerated_SouthRegionSalesPerformanceRisks-13cb8515
liveboard:
  name: agentGenerated_South Region Sales Performance Risks
  visualizations:
  - id: Viz_1
    viz_guid: 25c77181-8ca3-4191-be24-297bc31fd3e7
    note_tile:
      html_parsed_string: |-
        Key Drivers:
        • South region generates 46% less sales than West region with lowest total profit at $46,749
        • Three states (North Carolina, Tennessee, Florida) losing combined $16,231 in profit due to excessive 28-30% discount rates
        • Furniture category operating at critically low 5.8% profit margin vs 15.9% for office supplies
        • High discount correlation with losses - unprofitable states averaging 29% discounts vs profitable areas

        Recommendations:
        • Immediately review discount policies in NC, TN, FL and cap at 20% maximum
        • Restructure furniture pricing strategy or reduce low-margin SKUs in category mix
        • Increase sales focus and territory coverage in South region to boost volume
  - id: Viz_2
    answer:
      name: "Total sales, total profit, sum of quantity, and average discount by region"
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      search_query: "sum [Sales] sum [Profit] sum [Quantity] average [Discount] [Region]"
      answer_columns:
      - name: Average Discount
      - name: Region
      - name: Total Profit
      - name: Total Quantity
      - name: Total Sales
      table:
        table_columns:
        - column_id: Average Discount
          headline_aggregation: TABLE_AGGR
        - column_id: Region
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Profit
          headline_aggregation: SUM
        - column_id: Total Quantity
          headline_aggregation: SUM
        - column_id: Total Sales
          headline_aggregation: SUM
        ordered_column_ids:
        - Region
        - Total Sales
        - Total Profit
        - Total Quantity
        - Average Discount
        client_state: ""
