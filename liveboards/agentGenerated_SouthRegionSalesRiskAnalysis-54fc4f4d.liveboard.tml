obj_id: agentGenerated_SouthRegionSalesRiskAnalysis-54fc4f4d
liveboard:
  name: agentGenerated_South Region Sales Risk Analysis
  visualizations:
  - id: Viz_1
    viz_guid: 565672d9-12fb-40b1-87d1-784412498120
    note_tile:
      html_parsed_string: |-
        Key Drivers:
        • South region generates lowest sales at $391K vs West's $725K (46% gap)
        • 2024 profit margin collapsed to 7.2% from 18.9% in 2023 despite 31% sales growth
        • Tables sub-category lost $4,623 with 22% average discount rate
        • Machines category unprofitable with 33% discount rate destroying margins

        Recommendations:
        • Reduce discounting on Tables and Machines categories to restore profitability
        • Investigate 2024 cost structure changes causing margin erosion
        • Focus sales efforts on profitable sub-categories to close regional revenue gap
  - id: Viz_2
    answer:
      name: "Sales, Profit by Region sorted by Sales descending"
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      search_query: "[Sales] [Profit] [Region] sort by [Sales] descending"
      answer_columns:
      - name: Region
      - name: Total Profit
      - name: Total Sales
        sort_info:
          category: DEFAULT
      table:
        table_columns:
        - column_id: Region
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Profit
          headline_aggregation: SUM
        - column_id: Total Sales
          headline_aggregation: SUM
        ordered_column_ids:
        - Region
        - Total Sales
        - Total Profit
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Region\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}}]}"
      chart:
        type: ADVANCED_COLUMN
        chart_columns:
        - column_id: Region
        - column_id: Total Profit
        - column_id: Total Sales
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"Total Sales\",\"columnProperty\": {}},{\"columnId\": \"Region\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"b41d4918-7f41-4657-9a15-48775736fe17\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Sales\"],\"isOpposite\": false}},{\"id\": \"8d52b3d7-2d9a-44b3-b667-bb42eeee6285\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Profit\"],\"isOpposite\": true}},{\"id\": \"2e455a43-3de8-4293-9704-9819527b9fe7\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Region\"]}}]}"
        custom_chart_config:
        - key: basic
          dimensions:
          - key: x-axis
            axes:
            - type: FLAT
              column: Region
            mode: AXIS_DRIVEN
          - key: y-axis
            axes:
            - type: MERGED
              columns:
              - Total Sales
              - Total Profit
            mode: AXIS_DRIVEN
          - key: slice-with-color
            mode: AXIS_DRIVEN
          - key: trellis-by
            mode: AXIS_DRIVEN
      display_mode: TABLE_MODE
    viz_guid: 9a0abbea-83df-4a40-97f7-94e1e970c037
  - id: Viz_3
    answer:
      name: "Sales, Profit by yearly Order Date where Region is South"
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      search_query: "[Sales] [Profit] [Order Date].yearly [Region] = 'south'"
      answer_columns:
      - name: Total Profit
      - name: Total Sales
      - name: Year(Order Date)
      table:
        table_columns:
        - column_id: Total Profit
          headline_aggregation: SUM
        - column_id: Total Sales
          headline_aggregation: SUM
        - column_id: Year(Order Date)
          headline_aggregation: MIN-MAX
        ordered_column_ids:
