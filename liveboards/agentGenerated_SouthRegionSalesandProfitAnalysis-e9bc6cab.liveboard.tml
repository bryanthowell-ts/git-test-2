obj_id: agentGenerated_SouthRegionSalesandProfitAnalysis-e9bc6cab
liveboard:
  name: agentGenerated_South Region Sales and Profit Analysis
  visualizations:
  - id: Viz_1
    viz_guid: f9f95327-cb61-4544-a2b2-af6174ca1b10
    note_tile:
      html_parsed_string: |-
        Key Drivers:
        • Tables sub-category generating $43,916 in sales but losing $4,623 in profit
        • Machines sub-category has highest discount rate at 33.3%, resulting in $1,439 loss
        • Home Office segment shows significantly lower profit margin at 6.2% vs Consumer at 13.8%
        • Technology products (Phones, Accessories) drive highest profits with low 9-10% discount rates

        Recommendations:
        • Reduce discounting on Machines from 33.3% and reassess Tables pricing strategy
        • Focus sales efforts on high-margin Technology products and Consumer segment
        • Investigate Home Office segment pricing to improve 6.2% profit margin
  - id: Viz_2
    answer:
      name: Sales and Profit by Segment where Region is South
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      search_query: "[Sales] [Profit] [Segment] [Region] = 'south'"
      answer_columns:
      - name: Segment
      - name: Total Profit
      - name: Total Sales
      table:
        table_columns:
        - column_id: Segment
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Profit
          headline_aggregation: SUM
        - column_id: Total Sales
          headline_aggregation: SUM
        ordered_column_ids:
        - Segment
        - Total Sales
        - Total Profit
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Segment\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}}]}"
