obj_id: agentGenerated_MonthlySalesTrendsByYear-c3fbe2f7
liveboard:
  name: agentGenerated_Monthly Sales Trends By Year
  visualizations:
  - id: Viz_1
    viz_guid: 55d85cf6-55d9-4d0f-8a00-e0b7f43fd2f0
    note_tile:
      html_parsed_string: |-
        Key Drivers:
        • March consistently shows strongest MoM growth across all years (+1132% in 2021, +224% in 2022, +125% in 2023, +190% in 2024)
        • September and November are reliable high-growth months with September averaging +165% growth
        • January-February consistently show negative MoM growth due to post-holiday sales decline
        • Q4 months maintain higher sales volumes despite variable growth rates

        Recommendations:
        • Increase inventory and marketing spend ahead of March peak season to maximize revenue opportunity
        • Develop targeted promotions for January-February to counteract seasonal decline
        • Leverage September momentum with back-to-school campaigns and November with pre-holiday pushes
  - id: Viz_2
    answer:
      name: "Total Sales by month and year using Order Date, showing month over month comparison for each year"
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      search_query: "growth of [Sales] by [Order Date] [Order Date].monthly"
      answer_columns:
