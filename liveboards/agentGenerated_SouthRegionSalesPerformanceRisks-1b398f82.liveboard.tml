obj_id: agentGenerated_SouthRegionSalesPerformanceRisks-1b398f82
liveboard:
  name: agentGenerated_South Region Sales Performance Risks
  visualizations:
  - id: Viz_1
    viz_guid: 2635d26b-57c5-4fc9-b02b-216bcfa49e99
    note_tile:
      html_parsed_string: |-
        Key Drivers:
        • North Carolina, Tennessee, and Florida operating at combined loss of 16,231 units with Florida showing -3.8% margin despite highest revenue
        • Tables and Machines sub-categories generating 6,060 units in losses, with Tables showing -10.5% profit margin
        • South region has smallest order volume at 1,620 orders representing only 17% of total company sales
        • Individual high-loss products like Cubify CubeX 3D Printer contributing significant losses

        Recommendations:
        • Immediately review pricing and cost structure for Tables and Machines categories to eliminate negative margins
        • Implement targeted profitability improvement plan for North Carolina, Tennessee, and Florida operations
        • Increase sales volume through enhanced marketing and customer acquisition in the South region
  - id: Viz_2
    answer:
      name: Bottom 10 Products by Profit where Region is South
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      search_query: "bottom 10 [Product Name] [Region] = 'south' sort by [Profit]"
      answer_columns:
      - name: Product Name
      - name: Total Profit
      table:
        table_columns:
        - column_id: Product Name
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Profit
          headline_aggregation: SUM
        ordered_column_ids:
        - Product Name
        - Total Profit
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Product Name\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}}]}"
      chart:
        type: BAR
        chart_columns:
