obj_id: agentGenerated_SouthRegionSalesPerformanceRisks-06a62eee
liveboard:
  name: agentGenerated_South Region Sales Performance Risks
  visualizations:
  - id: Viz_1
    viz_guid: 9dd86301-4cb1-4e05-bd3d-8565e57bddaa
    note_tile:
      html_parsed_string: "Key Drivers:\n• South region underperforms by 46% in sales and 57% in profit compared to top region\n• Tables and Machines sub-categories generate net losses of $4,623 and $1,439 respectively  \n• Excessive discounting in Binders (70%), Machines (50%), and Tables (42%) erodes margins\n• Cubify 3D Printer leads worst performers with $3,840 loss despite $8,000 in sales\n\nRecommendations:\n• Immediately review pricing strategy for Tables and Machines to eliminate losses\n• Cap discount rates at 30% maximum for loss-generating sub-categories\n• Discontinue or repriced worst-performing products like Cubify 3D Printer"
  - id: Viz_2
    answer:
      name: "Sales, Profit, Quantity, and average Discount by Region to compare South region performance against other regions"
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      search_query: "[Sales] [Profit] [Quantity] average [Discount] [Region]"
      answer_columns:
      - name: Average Discount
      - name: Region
      - name: Total Profit
      - name: Total Quantity
      - name: Total Sales
      table:
        table_columns:
        - column_id: Average Discount
          headline_aggregation: TABLE_AGGR
        - column_id: Region
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Profit
          headline_aggregation: SUM
        - column_id: Total Quantity
          headline_aggregation: SUM
        - column_id: Total Sales
          headline_aggregation: SUM
        ordered_column_ids:
        - Region
        - Total Sales
        - Total Profit
        - Total Quantity
        - Average Discount
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Region\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}},{\"columnId\": \"Total Quantity\",\"columnProperty\": {}},{\"columnId\": \"Average Discount\",\"columnProperty\": {}}]}"
      chart:
        type: ADVANCED_COLUMN
        chart_columns:
        - column_id: Average Discount
        - column_id: Region
        - column_id: Total Profit
        - column_id: Total Quantity
        - column_id: Total Sales
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"Total Quantity\",\"columnProperty\": {}},{\"columnId\": \"Region\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}},{\"columnId\": \"Average Discount\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"07694b89-6f1d-4003-9432-5acabd5d7a99\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Sales\"],\"isOpposite\": false}},{\"id\": \"dfb93554-cc01-478f-a29e-6e2655d416e7\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Profit\"],\"isOpposite\": true}},{\"id\": \"aa85d908-caba-4bdb-a787-d059972da4f6\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Quantity\"],\"isOpposite\": true}},{\"id\": \"f05fe765-e6a4-4d99-b230-720e560826f5\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Region\"]}}]}"
        custom_chart_config:
        - key: basic
          dimensions:
          - key: x-axis
            axes:
            - type: FLAT
              column: Region
            mode: AXIS_DRIVEN
          - key: y-axis
            axes:
            - type: FLAT
              column: Total Sales
            - type: FLAT
              column: Total Profit
            - type: FLAT
              column: Total Quantity
            mode: AXIS_DRIVEN
          - key: slice-with-color
            mode: AXIS_DRIVEN
          - key: trellis-by
            mode: AXIS_DRIVEN
      display_mode: TABLE_MODE
    viz_guid: dcad6664-0fa7-4f26-aa51-edc8da717a61
