          - Sales this year
          - Sales last year
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"Sales last year\",\"columnProperty\": {}},{\"columnId\": \"Sales this year\",\"columnProperty\": {}},{\"columnId\": \"YoY growth percentage\",\"columnProperty\": {}},{\"columnId\": \"Region\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"5609324b-d8a7-4d24-b823-084ead43f6bb\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"YoY growth percentage\"],\"isOpposite\": false}},{\"id\": \"0623c4db-1d0f-4ed6-8e68-2314eda683d7\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Sales this year\"],\"isOpposite\": true}},{\"id\": \"e3615adc-71da-4473-9123-f9568bafa229\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Sales last year\"],\"isOpposite\": true}},{\"id\": \"fb6758f7-6d67-4272-ad02-54da5fcb41f9\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Region\"]}}]}"
