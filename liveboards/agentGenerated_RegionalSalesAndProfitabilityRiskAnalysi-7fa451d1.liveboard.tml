  - id: Viz_7
    answer:
      name: Year-over-year Sales growth percentage by Region for this year vs last year
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      formulas:
      - id: formula_YoY growth percentage
        name: YoY growth percentage
        expr: "( [formula_Sales this year] - [formula_Sales last year] ) / [formula_Sales last year] * 100"
        was_auto_generated: false
      - id: formula_Sales last year
        name: Sales last year
        expr: "group_aggregate ( sum ( [Sales] ) , query_groups ( ) , query_filters ( ) + { diff_years ( [Order Date] , today ( ) ) = - 1 } )"
        was_auto_generated: false
      - id: formula_Sales this year
        name: Sales this year
        expr: "group_aggregate ( sum ( [Sales] ) , query_groups ( ) , query_filters ( ) + { diff_years ( [Order Date] , today ( ) ) = 0 } )"
        was_auto_generated: false
      search_query: "[formula_YoY growth percentage] [formula_Sales this year] [formula_Sales last year] [Region]"
      answer_columns:
      - name: Region
      - name: Sales last year
      - name: Sales this year
      - name: YoY growth percentage
      table:
        table_columns:
        - column_id: Region
          headline_aggregation: COUNT_DISTINCT
        - column_id: Sales last year
          headline_aggregation: TABLE_AGGR
        - column_id: Sales this year
          headline_aggregation: TABLE_AGGR
        - column_id: YoY growth percentage
          headline_aggregation: TABLE_AGGR
        ordered_column_ids:
        - Region
        - YoY growth percentage
        - Sales this year
        - Sales last year
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Region\",\"columnProperty\": {}},{\"columnId\": \"YoY growth percentage\",\"columnProperty\": {}},{\"columnId\": \"Sales this year\",\"columnProperty\": {}},{\"columnId\": \"Sales last year\",\"columnProperty\": {}}]}"
      chart:
        type: BAR
        chart_columns:
        - column_id: Region
        - column_id: Sales last year
        - column_id: Sales this year
        - column_id: YoY growth percentage
        axis_configs:
        - x:
