  - id: Viz_5
    answer:
      name: "Total Sales, Total Profit, Profit Margin (Profit/Sales) by Region"
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      formulas:
      - id: formula_Profit Margin
        name: Profit Margin
        expr: "sum ( [Profit] ) / sum ( [Sales] )"
