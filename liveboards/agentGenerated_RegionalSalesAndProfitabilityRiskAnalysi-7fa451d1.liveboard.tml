obj_id: agentGenerated_RegionalSalesAndProfitabilityRiskAnalysi-7fa451d1
liveboard:
  name: agentGenerated_Regional Sales And Profitability Risk Analysis
  visualizations:
  - id: Viz_1
    viz_guid: ae8f3670-fc13-4182-9bef-652bf2a2c18a
    note_tile:
      html_parsed_string: |-
        Key Drivers:
        • Central region shows highest risk with 7.9% profit margin vs 14.9% in West, driven by excessive 24% average discounting
        • South region has smallest sales volume and heavy losses in Tables & Machines categories
        • East region suffers large losses in Machines & Tables despite solid overall profitability
        • Central's profit margin is nearly half of West's despite higher sales than South

        Recommendations:
        • Immediately reduce Central region discounting from 24% to under 15% to improve margins
        • Restructure Tables & Machines product lines in South and East regions to stop losses
        • Focus growth investments on West region given strongest 14.9% margins and lowest risk profile
  - id: Viz_2
    answer:
      name: "Average Discount, Total Profit, Total Sales by Region"
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      search_query: "average [Discount] [Profit] [Sales] [Region]"
      answer_columns:
      - name: Average Discount
      - name: Region
      - name: Total Profit
      - name: Total Sales
      table:
        table_columns:
        - column_id: Average Discount
          headline_aggregation: TABLE_AGGR
        - column_id: Region
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Profit
          headline_aggregation: SUM
        - column_id: Total Sales
          headline_aggregation: SUM
        ordered_column_ids:
        - Region
        - Average Discount
        - Total Profit
        - Total Sales
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Region\",\"columnProperty\": {}},{\"columnId\": \"Average Discount\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}}]}"
      chart:
        type: BAR
        chart_columns:
        - column_id: Average Discount
        - column_id: Region
        - column_id: Total Profit
        - column_id: Total Sales
        axis_configs:
        - x:
          - Region
          "y":
          - Average Discount
          - Total Profit
          - Total Sales
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"Total Profit\",\"columnProperty\": {}},{\"columnId\": \"Region\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}},{\"columnId\": \"Average Discount\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"34b176a5-25b7-4bf3-9bd7-5d88cad5590f\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Average Discount\"],\"isOpposite\": false}},{\"id\": \"edbb573e-ced6-4254-a079-67cd8df6adfa\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Profit\"],\"isOpposite\": true}},{\"id\": \"dae35983-f21b-4d6e-b991-b8d4cf8c9d33\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Sales\"],\"isOpposite\": true}},{\"id\": \"e4dd9b9f-8f42-42ff-96cb-b2a892fab448\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Region\"]}}]}"
