obj_id: agentGenerated_SouthRegionSalesPerformanceRisks-ec45a35d
liveboard:
  name: agentGenerated_South Region Sales Performance Risks
  visualizations:
  - id: Viz_1
    viz_guid: 57e2da76-5287-45ba-b281-08d3eb12b6ec
    note_tile:
      html_parsed_string: |-
        Key Drivers:
        • South region generates 57% less profit than top-performing West region (46,749 vs 108,418)
        • Three states create combined losses of -16,232: North Carolina (-7,491), Tennessee (-5,342), Florida (-3,399)
        • Tables and Machines sub-categories lose -6,062 despite representing 25% of regional sales
        • Machines category shows excessive 33% average discount rate eroding margins

        Recommendations:
        • Immediately review pricing strategy for Tables and Machines categories to restore profitability
        • Reduce discount rates in Machines category from current 33% level
        • Focus turnaround efforts on North Carolina, Tennessee, and Florida loss-making states
  - id: Viz_2
    answer:
      name: Sales and Profit by Region sorted by Profit ascending
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      search_query: "[Sales] [Profit] [Region] sort by [Profit] ascending"
      answer_columns:
      - name: Region
      - name: Total Profit
        sort_info:
          category: DEFAULT
      - name: Total Sales
      table:
        table_columns:
        - column_id: Region
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Profit
          headline_aggregation: SUM
        - column_id: Total Sales
          headline_aggregation: SUM
        ordered_column_ids:
        - Region
        - Total Sales
        - Total Profit
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Region\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}}]}"
      chart:
        type: ADVANCED_COLUMN
        chart_columns:
        - column_id: Region
        - column_id: Total Profit
        - column_id: Total Sales
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"Total Profit\",\"columnProperty\": {}},{\"columnId\": \"Region\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"849a9ffb-7b2e-42a8-b471-d794c26b0f89\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Sales\"],\"isOpposite\": false}},{\"id\": \"5490c9cb-14da-4209-8b72-966ace5edfb2\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Profit\"],\"isOpposite\": true}},{\"id\": \"33e57d6f-6de5-4880-a96a-4cb16b1657a6\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Region\"]}}]}"
        custom_chart_config:
        - key: basic
          dimensions:
          - key: x-axis
            axes:
            - type: FLAT
              column: Region
            mode: AXIS_DRIVEN
          - key: y-axis
            axes:
            - type: MERGED
              columns:
              - Total Sales
              - Total Profit
            mode: AXIS_DRIVEN
          - key: slice-with-color
            mode: AXIS_DRIVEN
          - key: trellis-by
            mode: AXIS_DRIVEN
      display_mode: TABLE_MODE
    viz_guid: 53499285-bb1b-40a3-8dc9-82623145c3b4
