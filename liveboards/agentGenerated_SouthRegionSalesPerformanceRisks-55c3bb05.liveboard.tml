obj_id: agentGenerated_SouthRegionSalesPerformanceRisks-55c3bb05
liveboard:
  name: agentGenerated_South Region Sales Performance Risks
  visualizations:
  - id: Viz_1
    viz_guid: 522afca5-b3ea-40fe-9647-e6533b6cc970
    note_tile:
      html_parsed_string: |-
        Key Drivers:
        • South region is smallest market with only 17.1% of total company sales vs 31.6% for West region
        • Tables and Machines sub-categories losing $4,623 and $1,439 respectively with negative profit margins
        • Top 10 loss-making products account for over $15,000 in losses, mostly high-ticket furniture and technology
        • Furniture category has lowest profit margin at 5.8% vs 15.9% for Office Supplies

        Recommendations:
        • Discontinue or reprice loss-making Tables and Machines products to eliminate $6,000+ profit drain
        • Review pricing strategy for top loss-making products, especially high-ticket furniture items
        • Focus growth investments on higher-margin Office Supplies category while addressing Furniture profitability
  - id: Viz_2
    answer:
      name: "Show total Sales, total Profit, total Quantity, and average Discount by Region"
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      search_query: "sum [Sales] sum [Profit] sum [Quantity] average [Discount] [Region]"
      answer_columns:
      - name: Average Discount
      - name: Region
      - name: Total Profit
      - name: Total Quantity
      - name: Total Sales
      table:
        table_columns:
        - column_id: Average Discount
          headline_aggregation: TABLE_AGGR
        - column_id: Region
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Profit
          headline_aggregation: SUM
        - column_id: Total Quantity
          headline_aggregation: SUM
        - column_id: Total Sales
          headline_aggregation: SUM
        ordered_column_ids:
        - Region
        - Total Sales
        - Total Profit
        - Total Quantity
        - Average Discount
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Region\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}},{\"columnId\": \"Total Quantity\",\"columnProperty\": {}},{\"columnId\": \"Average Discount\",\"columnProperty\": {}}]}"
      chart:
        type: ADVANCED_COLUMN
        chart_columns:
        - column_id: Average Discount
        - column_id: Region
        - column_id: Total Profit
        - column_id: Total Quantity
        - column_id: Total Sales
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"Average Discount\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}},{\"columnId\": \"Total Quantity\",\"columnProperty\": {}},{\"columnId\": \"Region\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"6b78ae77-ac9e-4a6a-bd51-662c1235484c\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Sales\"],\"isOpposite\": false}},{\"id\": \"47d47b71-02c6-4d1a-9ba8-77a529340afc\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Profit\"],\"isOpposite\": true}},{\"id\": \"cff96120-31ce-418c-971e-99bd9128b904\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Quantity\"],\"isOpposite\": true}},{\"id\": \"a540c288-42bc-44bc-9875-483cd56e8c5c\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Region\"]}}]}"
