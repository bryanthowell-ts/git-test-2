  - id: Viz_4
    answer:
      name: What is the percentage contribution of each region to the total revenue?
      tables:
      - id: (Sample) Retail - Apparel
        name: (Sample) Retail - Apparel
        obj_id: SampleRetail-Apparel-cd252e5c
      formulas:
      - id: formula_percentage contribution
        name: percentage contribution
        expr: "[formula_sales by region] / [formula_total sales] * 100"
        was_auto_generated: false
      - id: formula_sales by region
        name: sales by region
        expr: "group_aggregate ( sum ( [sales] ) , query_groups ( ) , query_filters ( ) )"
        was_auto_generated: false
      - id: formula_total sales
        name: total sales
        expr: "group_aggregate ( sum ( [sales] ) , query_groups ( ) - { [region] } , query_filters ( ) )"
        was_auto_generated: false
      search_query: "[formula_percentage contribution] [region]"
      answer_columns:
      - name: percentage contribution
      - name: region
      table:
        table_columns:
        - column_id: percentage contribution
          headline_aggregation: TABLE_AGGR
        - column_id: region
          headline_aggregation: COUNT_DISTINCT
        ordered_column_ids:
        - region
        - percentage contribution
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"region\",\"columnProperty\": {}},{\"columnId\": \"percentage contribution\",\"columnProperty\": {}}]}"
      chart:
        type: COLUMN
        chart_columns:
        - column_id: percentage contribution
        - column_id: region
        axis_configs:
        - x:
          - region
          "y":
          - percentage contribution
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"percentage contribution\",\"columnProperty\": {}},{\"columnId\": \"region\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"e8553c04-fa55-4aa4-9d47-98cfd0449b6c\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"percentage contribution\"],\"isOpposite\": false}},{\"id\": \"b0d14296-5260-446c-84ef-8043bcb6edd5\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"region\"]}}]}"
      display_mode: CHART_MODE
