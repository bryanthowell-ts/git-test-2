  - id: Viz_5
    answer:
      name: How does the total revenue for each region compare to the average regional revenue?
      tables:
      - id: (Sample) Retail - Apparel
        name: (Sample) Retail - Apparel
        obj_id: SampleRetail-Apparel-cd252e5c
      formulas:
      - id: formula_average regional revenue
        name: average regional revenue
        expr: "group_aggregate ( sum ( [sales] ) , { } , { } ) / group_aggregate ( unique count ( [region] ) , { } , { } )"
        was_auto_generated: false
      search_query: "[sales] [formula_average regional revenue] [region]"
      answer_columns:
      - name: Total sales
      - name: average regional revenue
      - name: region
      table:
        table_columns:
        - column_id: Total sales
          headline_aggregation: SUM
        - column_id: average regional revenue
          headline_aggregation: SUM
        - column_id: region
          headline_aggregation: COUNT_DISTINCT
        ordered_column_ids:
        - region
        - Total sales
        - average regional revenue
        client_state: ""
