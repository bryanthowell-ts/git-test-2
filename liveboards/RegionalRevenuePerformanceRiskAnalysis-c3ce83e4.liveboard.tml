          - average regional revenue
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"Total sales\",\"columnProperty\": {}},{\"columnId\": \"average regional revenue\",\"columnProperty\": {}},{\"columnId\": \"region\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"fd5a33e8-f2ff-4f69-9fec-559bdaa3ce2d\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total sales\"],\"isOpposite\": false}},{\"id\": \"804bb6e7-728f-4262-b69e-38ad0ee6e32e\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"average regional revenue\"],\"isOpposite\": true}},{\"id\": \"7990a8c5-012f-4af4-a8b1-37136883d3b3\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"region\"]}}]}"
