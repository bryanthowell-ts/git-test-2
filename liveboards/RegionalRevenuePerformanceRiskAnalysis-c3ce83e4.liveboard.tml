obj_id: RegionalRevenuePerformanceRiskAnalysis-c3ce83e4
liveboard:
  name: Regional Revenue Performance Risk Analysis
  visualizations:
  - id: Viz_1
    viz_guid: 78864e82-ca51-44cf-8b6b-17599a236a4a
    note_tile:
      html_parsed_string: "<h2 class=\"theme-module__editor-h2\" dir=\"ltr\" style=\"text-align: center; color: #c41e3a; margin-bottom: 20px;\"><span style=\"white-space: pre-wrap;\">⚠️ Regional Revenue Performance Risk Analysis</span></h2><p class=\"theme-module__editor-paragraph\" dir=\"ltr\" style=\"margin-bottom: 15px; color: #333;\"><span style=\"white-space: pre-wrap; font-weight: bold;\">Generated on March 30, 2026 at 15:13 UTC</span></p><div style=\"background-color: #fff3cd; border: 1px solid #ffeaa7; padding: 15px; margin: 10px 0; border-radius: 5px;\"><h3 style=\"color: #856404; margin: 0 0 10px 0;\">🎯 Key Risk Findings:</h3><ul style=\"margin: 0; padding-left: 20px; color: #856404;\"><li><strong>Critical Risk - South Region:</strong> Only contributes 4.2% of total revenue ($41M) and is 79% below the regional average ($194M)</li><li><strong>Volatility Risk - All Regions:</strong> Sharp revenue declines in Feb 2026 across all regions (-13% to -22%)</li><li><strong>Concentration Risk:</strong> West region dominates with 34.6% of total revenue, creating dependency risk</li></ul></div><div style=\"background-color: #d1ecf1; border: 1px solid #bee5eb; padding: 15px; margin: 10px 0; border-radius: 5px;\"><h3 style=\"color: #0c5460; margin: 0 0 10px 0;\">📊 Revenue Distribution Analysis:</h3><ul style=\"margin: 0; padding-left: 20px; color: #0c5460;\"><li><strong>West:</strong> $336M (34.6%) - Above average performance</li><li><strong>East:</strong> $252M (26.0%) - Above average performance</li><li><strong>Midwest:</strong> $225M (23.1%) - Above average performance</li><li><strong>Southwest:</strong> $117M (12.0%) - Below average performance</li><li><strong>South:</strong> $41M (4.2%) - Significantly underperforming</li></ul></div><div style=\"background-color: #f8d7da; border: 1px solid #f5c6cb; padding: 15px; margin: 10px 0; border-radius: 5px;\"><h3 style=\"color: #721c24; margin: 0 0 10px 0;\">⚡ Immediate Action Required:</h3><p style=\"margin: 0; color: #721c24; font-weight: bold;\">South region requires urgent intervention - investigate market conditions, competitive landscape, and operational efficiency to address the significant underperformance gap.</p></div><div class=\"pinboard-note-tile-module__noteTileBg editor-module__bgNode\"></div>"
  - id: Viz_2
    answer:
      name: What is my total revenue broken down by region?
      tables:
      - id: (Sample) Retail - Apparel
        name: (Sample) Retail - Apparel
        obj_id: SampleRetail-Apparel-cd252e5c
      search_query: "[sales] [region]"
      answer_columns:
      - name: Total sales
      - name: region
      table:
        table_columns:
        - column_id: Total sales
          headline_aggregation: SUM
        - column_id: region
          headline_aggregation: COUNT_DISTINCT
        ordered_column_ids:
        - region
        - Total sales
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"region\",\"columnProperty\": {}},{\"columnId\": \"Total sales\",\"columnProperty\": {}}]}"
      chart:
        type: COLUMN
        chart_columns:
        - column_id: Total sales
        - column_id: region
        axis_configs:
        - x:
          - region
          "y":
          - Total sales
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"region\",\"columnProperty\": {}},{\"columnId\": \"Total sales\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"87ac6e5f-1c67-4a57-a056-b512cb7ea724\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total sales\"],\"isOpposite\": false}},{\"id\": \"d81081b8-bd23-41d0-8596-f463cd05a8a3\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"region\"]}}]}"
      display_mode: CHART_MODE
