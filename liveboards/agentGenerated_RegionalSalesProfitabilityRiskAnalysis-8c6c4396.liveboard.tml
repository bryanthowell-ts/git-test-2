obj_id: agentGenerated_RegionalSalesProfitabilityRiskAnalysis-8c6c4396
liveboard:
  name: agentGenerated_Regional Sales Profitability Risk Analysis
  visualizations:
  - id: Viz_1
    viz_guid: 057bacaa-49ec-423f-830c-e48ac41e80f0
    note_tile:
      html_parsed_string: |-
        Key Drivers:
        • Central region generates 7.9% profit margin vs 14.9% in West region despite $501K sales
        • Furniture category in Central operates at -$2,871 loss with excessive 29.7% average discounts
        • Texas state shows -$25,729 profit loss with 37% discount rate, worst performer
        • Three states (TX, OH, PA) account for -$58K in losses due to high discount strategies

        Recommendations:
        • Immediately restructure discount policy in Central region, cap furniture discounts at 15%
        • Conduct pricing audit for Texas operations and reduce discount dependency
        • Consider product mix optimization in loss-making states
  - id: Viz_2
    answer:
      name: "Top 10 States with lowest Profit showing State, Region, Total Sales, Total Profit, and Average Discount sorted by Profit ascending"
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      search_query: "bottom 10 [Region] [State] sum [Sales] sum [Profit] average [Discount] sort by [Profit]"
      answer_columns:
      - name: Average Discount
      - name: Region
      - name: State
      - name: Total Profit
      - name: Total Sales
      table:
        table_columns:
        - column_id: Average Discount
          headline_aggregation: TABLE_AGGR
        - column_id: Region
          headline_aggregation: COUNT_DISTINCT
        - column_id: State
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Profit
          headline_aggregation: SUM
