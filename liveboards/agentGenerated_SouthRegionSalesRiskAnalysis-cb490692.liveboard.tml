obj_id: agentGenerated_SouthRegionSalesRiskAnalysis-cb490692
liveboard:
  name: agentGenerated_South Region Sales Risk Analysis
  visualizations:
  - id: Viz_1
    viz_guid: b8776aec-606f-4b08-89c0-8c2bf12e2c9a
    note_tile:
      html_parsed_string: "Key Drivers:\n• Tables sub-category losing $4,623 with -10.5% margin despite $43,916 sales\n• Machines generating $53,891 sales but -$1,439 profit (-2.7% margin) \n• Excessive discounting: Binders 37.6%, Machines 33.3%, Tables 22.3%\n• South region worst performing with only 17% of company sales, 16% of profit\n\nRecommendations:\n• Immediately review Tables pricing strategy or discontinue loss-making SKUs\n• Reduce discount rates on Machines and Tables categories by 10-15%\n• Focus sales efforts on profitable sub-categories with higher margins"
  - id: Viz_2
    answer:
      name: "Average Discount, Sum of Sales, Sum of Profit by Sub Category where Region is South, sorted by average Discount descending"
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      search_query: "average [Discount] [Sales] [Profit] [Sub Category] [Region] = 'south' sort by average [Discount] descending"
      answer_columns:
      - name: Average Discount
        sort_info:
          category: DEFAULT
      - name: Sub Category
      - name: Total Profit
      - name: Total Sales
      table:
        table_columns:
        - column_id: Average Discount
          headline_aggregation: TABLE_AGGR
        - column_id: Sub Category
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Profit
          headline_aggregation: SUM
        - column_id: Total Sales
          headline_aggregation: SUM
        ordered_column_ids:
        - Sub Category
        - Average Discount
        - Total Sales
        - Total Profit
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Sub Category\",\"columnProperty\": {}},{\"columnId\": \"Average Discount\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}}]}"
      chart:
        type: BAR
        chart_columns:
        - column_id: Average Discount
        - column_id: Sub Category
        - column_id: Total Profit
        - column_id: Total Sales
        axis_configs:
        - x:
          - Sub Category
          "y":
          - Average Discount
          - Total Sales
          - Total Profit
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"Sub Category\",\"columnProperty\": {}},{\"columnId\": \"Average Discount\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"9408f68b-0bbe-4e05-ab20-8d7cb52bf530\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Average Discount\"],\"isOpposite\": false}},{\"id\": \"b648b316-b843-47e8-88bb-199f2775bb26\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Sales\"],\"isOpposite\": true}},{\"id\": \"23c76b88-95e1-4b73-897b-59f09c0f7e29\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Profit\"],\"isOpposite\": true}},{\"id\": \"3bab227f-0e46-46c6-80ed-1bfe590acd32\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Sub Category\"]}}]}"
      display_mode: CHART_MODE
