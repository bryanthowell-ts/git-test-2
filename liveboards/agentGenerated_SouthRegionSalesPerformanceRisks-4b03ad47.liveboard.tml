obj_id: agentGenerated_SouthRegionSalesPerformanceRisks-4b03ad47
liveboard:
  name: agentGenerated_South Region Sales Performance Risks
  visualizations:
  - id: Viz_1
    viz_guid: 675675af-ccc9-4c7e-93a1-07c2c4720675
    note_tile:
      html_parsed_string: |-
        Key Drivers:
        • South region generates 46% less sales than leading West region with lowest quantity sold (6,209 units)
        • Tables and Machines sub-categories losing $6,062 combined despite $97,807 in sales volume
        • High profit volatility with losses in Nov 2024 (-$1,625) and Oct 2024 (-$2,243) despite strong sales
        • Discount rate of 14.7% contributing to margin pressure on underperforming categories

        Recommendations:
        • Immediately review pricing strategy for Tables and Machines to eliminate losses
        • Increase sales team focus and marketing investment in South region to boost volume
        • Implement monthly profit monitoring to catch volatility early and adjust tactics
  - id: Viz_2
    answer:
      name: "Sum of Sales, Sum of Profit, Sum of Quantity, and Average Discount by Region"
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      search_query: "[Sales] [Profit] [Quantity] average [Discount] [Region]"
      answer_columns:
      - name: Average Discount
      - name: Region
      - name: Total Profit
      - name: Total Quantity
      - name: Total Sales
      table:
        table_columns:
        - column_id: Average Discount
          headline_aggregation: TABLE_AGGR
        - column_id: Region
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Profit
          headline_aggregation: SUM
        - column_id: Total Quantity
          headline_aggregation: SUM
        - column_id: Total Sales
          headline_aggregation: SUM
        ordered_column_ids:
        - Region
        - Total Sales
        - Total Profit
        - Total Quantity
        - Average Discount
        client_state: ""
