  - id: Viz_6
    answer:
      name: Average Discount by Category where Region is South vs Average Discount by Category for all regions
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      formulas:
      - id: formula_Average Discount (All Regions)
        name: Average Discount (All Regions)
        expr: "group_aggregate ( average ( [Discount] ) , query_groups ( ) , { } )"
        was_auto_generated: false
      - id: formula_Average Discount (South)
        name: Average Discount (South)
        expr: "group_aggregate ( average ( [Discount] ) , query_groups ( ) , query_filters ( ) + { [Region] = 'South' } )"
        was_auto_generated: false
      search_query: "[formula_Average Discount (South)] [formula_Average Discount (All Regions)] [Category]"
      answer_columns:
      - name: Average Discount (All Regions)
      - name: Average Discount (South)
      - name: Category
      table:
