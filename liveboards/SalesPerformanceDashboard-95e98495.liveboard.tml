obj_id: SalesPerformanceDashboard-95e98495
liveboard:
  name: Sales Performance Dashboard
  visualizations:
  - id: Viz_1
    viz_guid: 5714bdc8-63f2-4a1e-ac7e-918f26209f0c
    note_tile:
      html_parsed_string: "<h2 class=\"theme-module__editor-h2\" dir=\"ltr\" style=\"text-align: center;\"><span style=\"white-space: pre-wrap; color: #2E86AB;\">📊 Sales Performance Analysis Dashboard</span></h2><p class=\"theme-module__editor-paragraph\" dir=\"ltr\" style=\"margin: 20px; padding: 15px; background-color: #f8f9fa; border-radius: 8px;\"><span style=\"white-space: pre-wrap; font-size: 14px; line-height: 1.6;\"><strong>Generated on March 27, 2026 at 19:15 UTC</strong><br><br>🔍 <strong style=\"color: #2E86AB;\">Executive Summary:</strong><br>This dashboard provides comprehensive sales performance insights across time series KPIs and regional analysis.<br><br>📈 <strong style=\"color: #A23B72;\">Key Metrics Analyzed:</strong><br>• <strong>Month-over-Month (MoM) Sales Growth:</strong> Tracks monthly sales momentum with fluctuations ranging from -17.8% to +12.1%<br>• <strong>Year-over-Year (YoY) Sales Growth:</strong> Shows annual growth patterns with significant variations across different months<br>• <strong>Regional Performance:</strong> Midwest leads with $107.3M in sales, followed by East ($94.3M) and West ($89.8M)<br>• <strong>Store-Level Analysis:</strong> 30 stores tracked with top performers in Colorado ($16.3M) and Massachusetts ($14.7M)<br><br>🎯 <strong style=\"color: #F18F01;\">Key Insights:</strong><br>• Midwest region demonstrates strongest sales performance<br>• Monthly growth shows seasonal patterns with summer months typically performing better<br>• Store performance varies significantly across locations, indicating potential optimization opportunities</span></p><div class=\"pinboard-note-tile-module__noteTileBg editor-module__bgNode\"></div>"
  - id: Viz_2
    answer:
      name: Show month-over-month (MoM) change in total sales for the last two years.
      tables:
      - id: (Sample) Retail - Apparel
        name: (Sample) Retail - Apparel
        obj_id: SampleRetail-Apparel-cd252e5c
      search_query: "growth of [sales] by [date] [date].monthly [date] = 'last two years'"
      answer_columns:
      - name: Growth of Total sales
      - name: Month(date)
      table:
        table_columns:
        - column_id: Growth of Total sales
          headline_aggregation: MIN
        - column_id: Month(date)
          headline_aggregation: MIN-MAX
        ordered_column_ids:
        - Month(date)
        - Growth of Total sales
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Month(date)\",\"columnProperty\": {}},{\"columnId\": \"Growth of Total sales\",\"columnProperty\": {}}]}"
      chart:
        type: LINE
        chart_columns:
        - column_id: Growth of Total sales
        - column_id: Month(date)
        axis_configs:
        - x:
          - Month(date)
          "y":
          - Growth of Total sales
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"Growth of Total sales\",\"columnProperty\": {}},{\"columnId\": \"Month(date)\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"777d591a-c03d-4193-b183-31a060f4845e\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Growth of Total sales\"],\"isOpposite\": false}},{\"id\": \"fdcaf3e0-e032-4025-9249-b9f1b80ecbd9\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Month(date)\"]}}]}"
