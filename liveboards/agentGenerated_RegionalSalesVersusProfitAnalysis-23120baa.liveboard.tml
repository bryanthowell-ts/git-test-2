obj_id: agentGenerated_RegionalSalesVersusProfitAnalysis-23120baa
liveboard:
  name: agentGenerated_Regional Sales Versus Profit Analysis
  visualizations:
  - id: Viz_1
    viz_guid: 7db26cbd-c5cf-4042-b76f-809a259f479e
    note_tile:
      html_parsed_string: |-
        Key Drivers:
        • West region drives highest performance with 725K sales and 108K profit (14.9% margin)
        • Central region underperforms with lowest profit margin at 7.9% despite 501K in sales
        • East region maintains strong 13.5% margin on 679K sales
        • South region achieves better margin efficiency (11.9%) than Central despite lower sales

        Recommendations:
        • Investigate Central region's cost structure to improve 7.9% margin performance
        • Replicate West region's successful practices across other territories
        • Focus growth investments in West and East regions given strong margin performance
  - id: Viz_2
    answer:
