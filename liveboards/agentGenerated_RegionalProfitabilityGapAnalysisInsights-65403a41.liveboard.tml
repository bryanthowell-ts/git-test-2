obj_id: agentGenerated_RegionalProfitabilityGapAnalysisInsights-65403a41
liveboard:
  name: agentGenerated_Regional Profitability Gap Analysis Insights
  visualizations:
  - id: Viz_1
    viz_guid: 0926038d-591e-41c5-8841-0ec3704df170
    note_tile:
      html_parsed_string: |-
        Key Drivers:
        • West region leads with 725K sales and 14.9% profit margin
        • Central region underperforms with only 7.9% profit margin despite 501K sales
        • Overall company profit margin of 12.5% with 2.3M total revenue
        • Regional performance varies significantly from 7.9% to 14.9% margins

        Recommendations:
        • Investigate Central region's low profitability - review discount rates and cost structure
        • Apply West region's best practices to underperforming regions
        • Focus growth efforts on profitable West and East markets
