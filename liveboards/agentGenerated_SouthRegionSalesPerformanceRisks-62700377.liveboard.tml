obj_id: agentGenerated_SouthRegionSalesPerformanceRisks-62700377
liveboard:
  name: agentGenerated_South Region Sales Performance Risks
  visualizations:
  - id: Viz_1
    viz_guid: 9f9863af-a3cf-49ba-87b7-44848b75557b
    note_tile:
      html_parsed_string: |-
        Key Drivers:
        • South region has lowest sales volume at only 54% of top-performing West region
        • Tables and Machines sub-categories losing $6,062 combined due to excessive discounting (22-33%)
        • Furniture category profit margin only 5.8% vs 13-16% for other categories
        • High discount rates (22-33%) on loss-making products eroding overall profitability

        Recommendations:
        • Implement strict discount controls on Tables and Machines, capping at 15% maximum
        • Develop targeted sales strategy to boost South region volume by 25-30%
        • Review furniture pricing strategy to improve margins from 5.8% to 10%+ target
  - id: Viz_2
    answer:
      name: Bottom 10 Products by Profit where Region is South
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      search_query: "bottom 10 [Product Name] [Region] = 'south' sort by [Profit]"
      answer_columns:
      - name: Product Name
      - name: Total Profit
      table:
        table_columns:
        - column_id: Product Name
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Profit
          headline_aggregation: SUM
        ordered_column_ids:
        - Product Name
        - Total Profit
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Product Name\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}}]}"
      chart:
        type: ADVANCED_BAR
        chart_columns:
        - column_id: Product Name
        - column_id: Total Profit
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"Total Profit\",\"columnProperty\": {}},{\"columnId\": \"Product Name\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"e2a8d69f-1770-411c-8de1-eabf4c97d04d\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Profit\"],\"isOpposite\": false}},{\"id\": \"18b83480-2e4c-4fad-950d-841edc8d770b\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Product Name\"]}}]}"
        custom_chart_config:
        - key: basic
          dimensions:
          - key: x-axis
            axes:
            - type: FLAT
              column: Total Profit
            mode: AXIS_DRIVEN
          - key: y-axis
            axes:
            - type: FLAT
              column: Product Name
            mode: AXIS_DRIVEN
          - key: slice-with-color
            mode: AXIS_DRIVEN
          - key: trellis-by
            mode: AXIS_DRIVEN
      display_mode: TABLE_MODE
    viz_guid: 32c679f9-4d61-4658-80c9-361724806edf
