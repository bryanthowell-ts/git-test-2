liveboard:
  name: agentGenerated_Central Region Profit Performance Drivers
  visualizations:
  - id: Viz_1
    viz_guid: c76133d9-908f-48d1-ba7d-e159dfc92c95
    note_tile:
      html_parsed_string: |-
        Key Drivers:
        • West region achieves highest profit margin at 14.9% vs Central's 7.9%
        • Central region has efficiency issues - higher sales than South but lowest profit margin
        • November 2024 hit peak monthly sales of 118,448 units
        • Holiday seasonality drives November-December sales spikes consistently

        Recommendations:
        • Investigate Central region's cost structure to improve 7.9% profit margin
        • Replicate West region's high-margin strategies across other territories
        • Optimize inventory for November-December seasonal peaks
  - id: Viz_2
