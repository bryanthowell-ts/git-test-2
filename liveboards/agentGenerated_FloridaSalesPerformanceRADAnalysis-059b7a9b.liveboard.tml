obj_id: agentGenerated_FloridaSalesPerformanceRADAnalysis-059b7a9b
liveboard:
  name: agentGenerated_Florida Sales Performance RAD Analysis
  visualizations:
  - id: Viz_1
    viz_guid: 683d348e-667f-4182-bf71-120b2a825d1b
    note_tile:
      html_parsed_string: |-
        Key Drivers:
        • Technology category generates $46,968 sales with positive profit while Furniture and Office Supplies operate at -9.8% and -8.6% margins respectively
        • Jacksonville dominates with $39,133 sales (44% of state total), 4.5x larger than second-place Miami
        • Machines and Phones sub-categories account for 44% of total revenue at $39,666 combined

        Recommendations:
        • Focus expansion efforts on profitable Technology products, especially Machines and Phones lines
        • Investigate pricing/cost structure for Furniture and Office Supplies to address negative margins
        • Leverage Jacksonville's strong performance as a distribution hub for other Florida markets
  - id: Viz_2
    answer:
      name: Sales and Profit by Category where State is Florida
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      search_query: "[Sales] [Profit] [Category] [State] = 'florida'"
      answer_columns:
      - name: Category
      - name: Total Profit
      - name: Total Sales
      table:
        table_columns:
        - column_id: Category
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Profit
          headline_aggregation: SUM
        - column_id: Total Sales
          headline_aggregation: SUM
        ordered_column_ids:
        - Category
        - Total Sales
        - Total Profit
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Category\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}}]}"
      chart:
        type: BAR
        chart_columns:
        - column_id: Category
        - column_id: Total Profit
        - column_id: Total Sales
        axis_configs:
        - x:
          - Category
          "y":
          - Total Sales
          - Total Profit
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"Total Profit\",\"columnProperty\": {}},{\"columnId\": \"Category\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"dbd03d3f-5167-4539-894f-f3fc79f02ee4\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Sales\"],\"isOpposite\": false}},{\"id\": \"effd02a0-24a4-4af5-b644-940f93b74e38\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Profit\"],\"isOpposite\": true}},{\"id\": \"967cdaaf-8f2a-4f9f-a626-ee4322bd39ec\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Category\"]}}]}"
