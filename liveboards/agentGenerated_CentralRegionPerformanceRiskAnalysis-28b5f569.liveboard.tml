obj_id: agentGenerated_CentralRegionPerformanceRiskAnalysis-28b5f569
liveboard:
  name: agentGenerated_Central Region Performance Risk Analysis
  visualizations:
  - id: Viz_1
    viz_guid: f7e7218d-d668-4b40-a3d6-b90f01c62815
    note_tile:
      html_parsed_string: |-
        Key Drivers:
        • Central region's excessive discounting (24% vs 10.9% in West) destroying profit margins
        • Central profit margin at 7.9% - nearly half of West's 14.9% despite higher sales volume
        • Central 2024 profit plummeted 62% from 19.9K to 7.5K with zero sales growth
        • South region has smallest sales footprint with volatile performance patterns

        Recommendations:
        • Implement immediate discount controls in Central - cap at 15% maximum
        • Review Central pricing strategy and sales incentive structure
        • Focus growth investments on West region given strongest margin performance
  - id: Viz_2
    answer:
      name: "Sales, Profit, Profit Margin (Profit/Sales), Average Discount by Category where Region is Central"
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      formulas:
      - id: formula_Profit Margin
        name: Profit Margin
        expr: "sum ( [Profit] ) / sum ( [Sales] )"
        was_auto_generated: false
      search_query: "[Sales] [Profit] [formula_Profit Margin] average [Discount] [Category] [Region] = 'central'"
      answer_columns:
      - name: Average Discount
      - name: Category
      - name: Profit Margin
      - name: Total Profit
      - name: Total Sales
      table:
        table_columns:
        - column_id: Average Discount
          headline_aggregation: TABLE_AGGR
        - column_id: Category
          headline_aggregation: COUNT_DISTINCT
        - column_id: Profit Margin
          headline_aggregation: TABLE_AGGR
        - column_id: Total Profit
          headline_aggregation: SUM
        - column_id: Total Sales
          headline_aggregation: SUM
        ordered_column_ids:
        - Category
        - Total Sales
        - Total Profit
        - Profit Margin
        - Average Discount
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Category\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}},{\"columnId\": \"Profit Margin\",\"columnProperty\": {}},{\"columnId\": \"Average Discount\",\"columnProperty\": {}}]}"
      chart:
        type: BAR
        chart_columns:
        - column_id: Average Discount
        - column_id: Category
        - column_id: Profit Margin
        - column_id: Total Profit
        - column_id: Total Sales
        axis_configs:
        - x:
          - Category
          "y":
          - Total Sales
          - Total Profit
          - Profit Margin
          - Average Discount
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"Total Sales\",\"columnProperty\": {}},{\"columnId\": \"Average Discount\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}},{\"columnId\": \"Profit Margin\",\"columnProperty\": {}},{\"columnId\": \"Category\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"0203a38d-881a-4c3b-81c4-4997a05eb153\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Sales\"],\"isOpposite\": false}},{\"id\": \"d025b893-d95f-48fb-bcf0-7d21960949f8\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Profit\"],\"isOpposite\": true}},{\"id\": \"e65f5627-9583-4883-b731-acdbc9b3041d\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Profit Margin\"],\"isOpposite\": true}},{\"id\": \"29f94bde-adc3-4012-9495-f3602d106182\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Average Discount\"],\"isOpposite\": true}},{\"id\": \"d89e2976-78dd-46dc-b4b8-165beeb69601\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Category\"]}}]}"
