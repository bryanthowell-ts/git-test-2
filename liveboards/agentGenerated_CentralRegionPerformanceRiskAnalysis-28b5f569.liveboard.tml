  - id: Viz_9
    answer:
      name: Compare Central's Average Discount vs all other regions Average Discount by Sub Category
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      formulas:
      - id: formula_Central Average Discount
        name: Central Average Discount
        expr: "group_aggregate ( average ( [Discount] ) , query_groups ( ) , query_filters ( ) + { [Region] = 'Central' } )"
        was_auto_generated: false
      - id: formula_Other Regions Average Discount
        name: Other Regions Average Discount
        expr: "group_aggregate ( average ( [Discount] ) , query_groups ( ) , query_filters ( ) + { [Region] != 'Central' } )"
        was_auto_generated: false
      search_query: "[formula_Central Average Discount] [formula_Other Regions Average Discount] [Sub Category]"
      answer_columns:
      - name: Central Average Discount
      - name: Other Regions Average Discount
      - name: Sub Category
      table:
        table_columns:
        - column_id: Central Average Discount
          headline_aggregation: TABLE_AGGR
        - column_id: Other Regions Average Discount
          headline_aggregation: TABLE_AGGR
        - column_id: Sub Category
          headline_aggregation: COUNT_DISTINCT
        ordered_column_ids:
        - Sub Category
        - Central Average Discount
        - Other Regions Average Discount
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Sub Category\",\"columnProperty\": {}},{\"columnId\": \"Central Average Discount\",\"columnProperty\": {}},{\"columnId\": \"Other Regions Average Discount\",\"columnProperty\": {}}]}"
      chart:
        type: BAR
        chart_columns:
        - column_id: Central Average Discount
        - column_id: Other Regions Average Discount
        - column_id: Sub Category
        axis_configs:
        - x:
          - Sub Category
          "y":
          - Central Average Discount
          - Other Regions Average Discount
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"Other Regions Average Discount\",\"columnProperty\": {}},{\"columnId\": \"Sub Category\",\"columnProperty\": {}},{\"columnId\": \"Central Average Discount\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"abd08cc9-143f-40c7-a076-2b1aaff5569e\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Central Average Discount\"],\"isOpposite\": false}},{\"id\": \"9df5ac76-8929-4e94-901d-a286a6ce837b\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Other Regions Average Discount\"],\"isOpposite\": true}},{\"id\": \"5a3cf4ef-6cca-466f-824a-4df10b702946\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Sub Category\"]}}]}"
