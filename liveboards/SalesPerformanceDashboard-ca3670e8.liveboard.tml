  name: Sales Performance Dashboard
  visualizations:
  - id: Viz_1
    viz_guid: bbed1385-04fb-489f-92aa-58e43d82cf87
    note_tile:
      html_parsed_string: "<h2 class=\"theme-module__editor-h2\" dir=\"ltr\" style=\"text-align: center;\"><span style=\"white-space: pre-wrap;\">📊 Sales Performance Dashboard</span></h2><p class=\"theme-module__editor-paragraph\" dir=\"ltr\"><span style=\"white-space: pre-wrap; color: #555; font-size: 14px;\">Generated on March 27, 2026 19:10 UTC</span></p><h3 style=\"color: #2E86C1; margin-top: 20px;\">🎯 Key Insights</h3><p class=\"theme-module__editor-paragraph\" dir=\"ltr\" style=\"margin: 10px 0;\"><span style=\"white-space: pre-wrap;\"><strong>📈 Time Series Performance:</strong><br>• <span style=\"color: #E74C3C;\">MoM Growth:</span> Monthly sales show volatility with peaks in March and September periods<br>• <span style=\"color: #27AE60;\">YoY Growth:</span> Strong recovery with +29.5% in 2023 and +20.4% in 2024 after initial decline</span></p><p class=\"theme-module__editor-paragraph\" dir=\"ltr\" style=\"margin: 10px 0;\"><span style=\"white-space: pre-wrap;\"><strong>🌍 Regional Performance:</strong><br>• <span style=\"color: #F39C12;\">Top Region:</span> West leads with $725K in sales and $108K profit<br>• <span style=\"color: #8E44AD;\">Market Share:</span> East ($679K), Central ($501K), South ($392K)<br>• <span style=\"color: #16A085;\">Profit Leaders:</span> West and East regions drive 70% of total profitability</span></p><div class=\"pinboard-note-tile-module__noteTileBg editor-module__bgNode\"></div>"
  - id: Viz_2
    answer:
      name: What is the month-over-month (MoM) percentage change in total sales for each month?
      tables:
      - id: Orders Raw
        name: Orders Raw
        obj_id: OrdersRaw-f75c466a
      search_query: "growth of [Sales] by [Order Date] [Order Date].monthly"
      answer_columns:
      - name: Growth of Total Sales
      - name: Month(Order Date)
      table:
        table_columns:
        - column_id: Growth of Total Sales
          headline_aggregation: MIN
        - column_id: Month(Order Date)
          headline_aggregation: MIN-MAX
        ordered_column_ids:
        - Month(Order Date)
        - Growth of Total Sales
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Month(Order Date)\",\"columnProperty\": {}},{\"columnId\": \"Growth of Total Sales\",\"columnProperty\": {}}]}"
      chart:
        type: LINE
        chart_columns:
        - column_id: Growth of Total Sales
        - column_id: Month(Order Date)
        axis_configs:
        - x:
          - Month(Order Date)
          "y":
          - Growth of Total Sales
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"Month(Order Date)\",\"columnProperty\": {}},{\"columnId\": \"Growth of Total Sales\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"538baf60-4c58-4a41-bc8a-1f8ec3a19df8\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Growth of Total Sales\"],\"isOpposite\": false}},{\"id\": \"f7538881-5d49-4d93-962e-44beaf748571\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Month(Order Date)\"]}}]}"
      display_mode: CHART_MODE
    viz_guid: 925cba4b-19bd-4a83-bb54-260ee7624a13
