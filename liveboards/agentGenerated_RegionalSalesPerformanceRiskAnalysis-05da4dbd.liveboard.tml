obj_id: agentGenerated_RegionalSalesPerformanceRiskAnalysis-05da4dbd
liveboard:
  name: agentGenerated_Regional Sales Performance Risk Analysis
  visualizations:
  - id: Viz_1
    viz_guid: ac46d21d-daac-4abd-99c3-f5ededadbc1a
    note_tile:
      html_parsed_string: "Key Drivers:\n• Central region showing critical risk with 24% discount rate vs 10.9% in West, resulting in only 7.9% profit margin\n• Furniture category generating $2,871 loss in Central region while profitable in other regions  \n• Tables sub-category losing $17,725 across all regions with -8.6% margin\n• Central region contributing only 14% of profit despite 22% of sales\n\nRecommendations:\n• Immediately review Central region pricing and discount policies to reduce 24% discount rate\n• Discontinue or restructure furniture sales strategy in Central region\n• Evaluate tables sub-category for potential elimination or major pricing overhaul"
  - id: Viz_2
    answer:
      name: "Total Sales, Total Profit by Category and Region"
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      search_query: "[Sales] [Profit] [Region] [Category]"
      answer_columns:
      - name: Category
      - name: Region
      - name: Total Profit
      - name: Total Sales
      table:
        table_columns:
        - column_id: Category
          headline_aggregation: COUNT_DISTINCT
        - column_id: Region
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Profit
          headline_aggregation: SUM
        - column_id: Total Sales
          headline_aggregation: SUM
        ordered_column_ids:
        - Region
        - Category
        - Total Sales
        - Total Profit
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Region\",\"columnProperty\": {}},{\"columnId\": \"Category\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}}]}"
      chart:
        type: BAR
        chart_columns:
        - column_id: Category
        - column_id: Region
        - column_id: Total Profit
        - column_id: Total Sales
        axis_configs:
        - x:
          - Category
          - Region
          "y":
          - Total Sales
          - Total Profit
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"Total Sales\",\"columnProperty\": {}},{\"columnId\": \"Category\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}},{\"columnId\": \"Region\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"5cc1357e-a710-48f2-b11b-d8684c75438e\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Sales\"],\"isOpposite\": false}},{\"id\": \"34fda1ab-7ac0-437d-b848-a860eecd10a7\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Profit\"],\"isOpposite\": true}},{\"id\": \"1974d2b7-66ca-4245-921e-d84829674d37\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Category\",\"Region\"]}}]}"
      display_mode: TABLE_MODE
    viz_guid: beafe297-ef37-4fc0-9815-b132de155e5c
