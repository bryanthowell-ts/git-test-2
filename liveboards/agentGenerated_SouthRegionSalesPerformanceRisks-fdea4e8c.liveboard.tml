obj_id: agentGenerated_SouthRegionSalesPerformanceRisks-fdea4e8c
liveboard:
  name: agentGenerated_South Region Sales Performance Risks
  visualizations:
  - id: Viz_1
    viz_guid: 1c0786fe-9902-46a7-9f20-d9d7fd290aeb
    note_tile:
      html_parsed_string: |-
        Key Drivers:
        • South region has lowest total sales (391K vs 725K for West) and second-lowest profit across all regions
        • Tables and Machines sub-categories generating -6,062 in combined losses despite healthy sales volumes
        • Three states (NC, TN, FL) operating at combined loss of -16,231, with Florida showing highest sales but negative profitability

        Recommendations:
        • Immediately review pricing strategy for Tables (-10.5% margin) and Machines sub-categories
        • Implement state-specific profit recovery plans for NC, TN, and FL focusing on cost reduction and pricing optimization
  - id: Viz_2
    answer:
      name: "Total Sales, Total Profit by State where Region is South sorted by Profit ascending"
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      search_query: "sum [Sales] sum [Profit] [State] [Region] = 'south' sort by [Profit]"
      answer_columns:
      - name: State
      - name: Total Profit
        sort_info:
          category: DEFAULT
      - name: Total Sales
      table:
        table_columns:
        - column_id: State
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Profit
          headline_aggregation: SUM
        - column_id: Total Sales
          headline_aggregation: SUM
        ordered_column_ids:
        - State
        - Total Sales
        - Total Profit
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"State\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}}]}"
      chart:
        type: BAR
        chart_columns:
        - column_id: State
        - column_id: Total Profit
        - column_id: Total Sales
        axis_configs:
        - x:
          - State
          "y":
          - Total Sales
          - Total Profit
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"Total Sales\",\"columnProperty\": {}},{\"columnId\": \"State\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"9b20cdc2-b9d8-43cf-bba6-23b636d092dc\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Sales\"],\"isOpposite\": false}},{\"id\": \"3e59cd2e-18a2-47e6-9ff6-9237d7db3edf\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Profit\"],\"isOpposite\": true}},{\"id\": \"add7c0bd-6c04-4b03-b904-531b9c52d72f\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"State\"]}}]}"
      display_mode: CHART_MODE
    viz_guid: e3d09fc2-6758-455e-bf15-010d83484754
