        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"region\",\"columnProperty\": {}},{\"columnId\": \"Total sales\",\"columnProperty\": {}},{\"columnId\": \"sales rank\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"819518f6-2e88-4f7d-945e-0be4f8950cf2\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total sales\"],\"isOpposite\": false}},{\"id\": \"944202b1-17e0-45f5-9b5a-d99309748d82\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"region\"]}}]}"
