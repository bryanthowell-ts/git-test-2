obj_id: agentGenerated_RADSuperstoreRegionalPerformanceAnalysis-69161696
liveboard:
  name: agentGenerated_RAD Superstore Regional Performance Analysis
  visualizations:
  - id: Viz_1
    viz_guid: 96e6712b-c832-4065-a210-02320c766c35
    note_tile:
      html_parsed_string: "Key Drivers:\n• Central region has lowest profit margin at 7.9% vs 15% in West despite 3rd highest sales\n• Excessive discounting in Central at 24% average (double other regions) eroding profitability  \n• Furniture category losing money (-2,871) only in Central region\n• Central generates lowest total profit (39,706) across all regions\n\nRecommendations:\n• Reduce Central region discount rates from 24% to align with profitable regions (10-15%)\n• Restructure furniture pricing/sourcing in Central to eliminate losses"
  - id: Viz_2
    answer:
      name: Show average Discount by Region sorted by Discount descending
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      search_query: "average [Discount] [Region] sort by [Discount] descending"
      answer_columns:
      - name: Average Discount
      - name: Region
      - name: Total Discount
        sort_info:
          category: DEFAULT
      table:
        table_columns:
        - column_id: Average Discount
          headline_aggregation: TABLE_AGGR
        - column_id: Region
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Discount
          headline_aggregation: SUM
        ordered_column_ids:
        - Region
        - Average Discount
        - Total Discount
