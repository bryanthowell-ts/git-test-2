obj_id: agentGenerated_TexasSalesPerformanceKeyMetrics-cddc314d
liveboard:
  name: agentGenerated_Texas Sales Performance Key Metrics
  visualizations:
  - id: Viz_1
    viz_guid: 05604db9-a93a-42ce-a187-b9154cd6b214
    note_tile:
      html_parsed_string: |-
        Key Drivers:
        • Texas operates at -15.1% profit margin with $25,729 total loss despite $170,188 in sales
        • Office Supplies category has devastating -41.8% margin, losing $18,585 on $44,491 sales
        • Consumer segment drives 56% of sales but accounts for 80% of total losses at -21.5% margin
        • Furniture category loses $10,436 despite generating $60,593 in revenue

        Recommendations:
        • Immediately restructure Office Supplies pricing and sourcing to address -41.8% margin
        • Focus sales efforts on Technology category which shows +5.1% profitability
        • Redesign Consumer segment strategy to reduce the $20,596 loss burden
  - id: Viz_2
    answer:
      name: "Total Sales, Total Profit by Category where State is Texas"
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      search_query: "[Sales] [Profit] [Category] [State] = 'texas'"
      answer_columns:
      - name: Category
      - name: Total Profit
      - name: Total Sales
      table:
        table_columns:
        - column_id: Category
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Profit
          headline_aggregation: SUM
        - column_id: Total Sales
          headline_aggregation: SUM
        ordered_column_ids:
        - Category
        - Total Sales
        - Total Profit
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Category\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}}]}"
      chart:
        type: BAR
        chart_columns:
        - column_id: Category
        - column_id: Total Profit
        - column_id: Total Sales
        axis_configs:
        - x:
          - Category
          "y":
          - Total Sales
          - Total Profit
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"Category\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"9a7ca9bf-1980-4e2b-96c4-8e91a1b87d1d\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Sales\"],\"isOpposite\": false}},{\"id\": \"acb81a83-5780-4825-b1c7-becc2b104d68\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Profit\"],\"isOpposite\": true}},{\"id\": \"e65d1093-5e5d-4c3e-ac00-acb73ae79d89\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Category\"]}}]}"
