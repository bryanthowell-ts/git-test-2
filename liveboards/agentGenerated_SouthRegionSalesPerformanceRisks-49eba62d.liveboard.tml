obj_id: agentGenerated_SouthRegionSalesPerformanceRisks-49eba62d
liveboard:
  name: agentGenerated_South Region Sales Performance Risks
  visualizations:
  - id: Viz_1
    viz_guid: 3cbd9f16-325a-4075-a66f-22a0b8efe20a
    note_tile:
      html_parsed_string: |-
        Key Drivers:
        • South region has lowest sales volume at $391,722 (54% of West region's performance)
        • Tables and Machines sub-categories are loss-making with -$4,623 and -$1,439 profit respectively
        • Excessive discounting pattern: Machines at 33.3% average discount correlates with negative profit
        • Three states showing significant profit losses creating geographic risk concentration

        Recommendations:
        • Immediately review pricing strategy for Tables and Machines to eliminate losses
        • Implement discount controls - cap Machines discounts below 25% threshold
        • Focus sales efforts on profitable sub-categories like Phones and Copiers in underperforming states
  - id: Viz_2
    answer:
      name: Bottom 10 states by Profit where Region is South
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      search_query: "bottom 10 [State] [Region] = 'south' sort by [Profit]"
      answer_columns:
      - name: State
      - name: Total Profit
      table:
        table_columns:
        - column_id: State
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Profit
          headline_aggregation: SUM
        ordered_column_ids:
        - State
        - Total Profit
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"State\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}}]}"
      chart:
        type: ADVANCED_BAR
        chart_columns:
        - column_id: State
        - column_id: Total Profit
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"Total Profit\",\"columnProperty\": {}},{\"columnId\": \"State\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"98f20538-4f51-472a-a1a6-d34a3efdd137\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Profit\"],\"isOpposite\": false}},{\"id\": \"ebf120bd-993d-47b2-ab8b-70a461a780cd\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"State\"]}}]}"
        custom_chart_config:
        - key: basic
          dimensions:
          - key: x-axis
            axes:
            - type: FLAT
              column: Total Profit
            mode: AXIS_DRIVEN
          - key: y-axis
            axes:
            - type: FLAT
              column: State
            mode: AXIS_DRIVEN
          - key: slice-with-color
            mode: AXIS_DRIVEN
          - key: trellis-by
            mode: AXIS_DRIVEN
      display_mode: TABLE_MODE
    viz_guid: 4a9fa587-c254-41a3-a429-968cd85aa7b0
  - id: Viz_3
