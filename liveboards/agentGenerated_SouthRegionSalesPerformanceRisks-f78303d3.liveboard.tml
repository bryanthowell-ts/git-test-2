obj_id: agentGenerated_SouthRegionSalesPerformanceRisks-f78303d3
liveboard:
  name: agentGenerated_South Region Sales Performance Risks
  visualizations:
  - id: Viz_1
    viz_guid: bed66969-0d2f-4d31-a11b-48482878fdcf
    note_tile:
      html_parsed_string: "Key Drivers:\n• South region has lowest sales at $391k, 46% below West region performance\n• 2024 profit margin collapsed from 18.9% to 7.2% despite 31% sales increase  \n• Tables sub-category losing $4,623 with 22.3% average discounts\n• Machines category losing $1,439 with excessive 33.3% discount rates\n\nRecommendations:\n• Immediately review discount policies, especially for Tables and Machines categories\n• Investigate cost structure changes causing 2024 profit margin decline\n• Focus sales efforts on profitable sub-categories while fixing loss-makers"
  - id: Viz_2
    answer:
      name: "Bottom 10 products by Profit for South region showing Product Name, Sales, Profit, Discount"
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      search_query: "bottom 10 [Product Name] [Sales] [Profit] [Discount] [Region] = 'south' sort by [Profit]"
      answer_columns:
      - name: Product Name
      - name: Total Discount
      - name: Total Profit
      - name: Total Sales
      table:
        table_columns:
        - column_id: Product Name
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Discount
          headline_aggregation: SUM
        - column_id: Total Profit
          headline_aggregation: SUM
        - column_id: Total Sales
          headline_aggregation: SUM
        ordered_column_ids:
        - Product Name
        - Total Sales
        - Total Profit
        - Total Discount
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Product Name\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}},{\"columnId\": \"Total Discount\",\"columnProperty\": {}}]}"
      chart:
        type: ADVANCED_BAR
        chart_columns:
        - column_id: Product Name
        - column_id: Total Discount
        - column_id: Total Profit
        - column_id: Total Sales
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"Product Name\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}},{\"columnId\": \"Total Discount\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"c783090e-28dd-4b37-894c-deff3cb52242\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Sales\"],\"isOpposite\": false}},{\"id\": \"f4faaafe-d1c5-47be-b5ba-18e99fc63775\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Profit\"],\"isOpposite\": true}},{\"id\": \"1bd294b2-5644-4d6a-95df-f02a2debf7b3\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Discount\"],\"isOpposite\": true}},{\"id\": \"6f9332e9-cf0f-46a7-a4fa-3f12dee75404\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Product Name\"]}}]}"
        custom_chart_config:
        - key: basic
          dimensions:
          - key: x-axis
            axes:
            - type: FLAT
              column: Total Sales
            - type: FLAT
              column: Total Profit
            - type: FLAT
              column: Total Discount
            mode: AXIS_DRIVEN
          - key: y-axis
            axes:
            - type: FLAT
              column: Product Name
            mode: AXIS_DRIVEN
          - key: slice-with-color
            mode: AXIS_DRIVEN
          - key: trellis-by
            mode: AXIS_DRIVEN
      display_mode: TABLE_MODE
