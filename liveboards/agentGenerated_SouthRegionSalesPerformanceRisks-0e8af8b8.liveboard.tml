obj_id: agentGenerated_SouthRegionSalesPerformanceRisks-0e8af8b8
liveboard:
  name: agentGenerated_South Region Sales Performance Risks
  visualizations:
  - id: Viz_1
    viz_guid: 49394e5f-06ca-4f7b-be99-867782867883
    note_tile:
      html_parsed_string: |-
        Key Drivers:
        • South region ranks last in all metrics: 46% lower sales, 57% lower profit than West region
        • Tables and Machines subcategories lose over $6,000 despite $98,000 in sales
        • Three states (NC, TN, FL) generate $175,739 sales but lose $16,232 in profit
        • Furniture category operates at only 5.8% profit margin vs healthier categories

        Recommendations:
        • Immediately review pricing strategy for Tables and Machines subcategories
        • Conduct operational audit in North Carolina, Tennessee, and Florida markets
        • Restructure furniture category pricing and cost structure
  - id: Viz_2
    answer:
      name: "Total Sales, Total Profit, Average Discount by Category where Region is South"
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      search_query: "sum [Sales] sum [Profit] average [Discount] [Category] [Region] = 'south'"
      answer_columns:
      - name: Average Discount
      - name: Category
      - name: Total Profit
      - name: Total Sales
      table:
        table_columns:
        - column_id: Average Discount
          headline_aggregation: TABLE_AGGR
        - column_id: Category
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Profit
          headline_aggregation: SUM
        - column_id: Total Sales
          headline_aggregation: SUM
        ordered_column_ids:
        - Category
        - Total Sales
        - Total Profit
        - Average Discount
        client_state: ""
