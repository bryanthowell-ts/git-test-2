  - id: Viz_6
    answer:
      name: "Show Region, total Sales, total Profit, and profit margin calculated as sum of Profit divided by sum of Sales multiplied by 100 as Profit Margin Percent, sorted by profit margin ascending"
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      formulas:
      - id: formula_Profit Margin Percent
        name: Profit Margin Percent
        expr: "sum ( [Profit] ) / sum ( [Sales] ) * 100"
        was_auto_generated: false
      search_query: "[Sales] [Profit] [formula_Profit Margin Percent] [Region] sort by [formula_Profit Margin Percent] ascending"
