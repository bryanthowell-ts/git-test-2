obj_id: agentGenerated_WeeklySalesPerformanceImprovementStrateg-b23a1aa9
liveboard:
  name: agentGenerated_Weekly Sales Performance Improvement Strategy
  visualizations:
  - id: Viz_1
    viz_guid: 4ab7688f-7dbb-4a46-8a5a-a22434d7b507
    note_tile:
      html_parsed_string: |-
        Key Drivers:
        • Friday sales are 186,407 (only 8.1% of total weekly sales) - lowest performing day
        • Current gap between Friday and next lowest day (Thursday) is ~47K
        • Friday contributes significantly less than weekend days (Sunday: 410K, Saturday: 334K)

        Recommendations:
        • Implement Friday flash sales or limited-time promotions to capture weekend shoppers early
        • Launch "Weekend Preview" campaigns Friday afternoons to drive immediate purchases
        • Target 25-30% improvement instead of 15% to meaningfully close gap to Thursday performance
  - id: Viz_2
    answer:
      name: Count of Order Id by day of week of Order Date
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      search_query: "unique count [Order Id] [Order Date].'day of week'"
      answer_columns:
      - name: Day of Week(Order Date)
      - name: Unique Number of Order Id
      table:
        table_columns:
        - column_id: Day of Week(Order Date)
          headline_aggregation: COUNT_DISTINCT
        - column_id: Unique Number of Order Id
          headline_aggregation: AVERAGE
        ordered_column_ids:
