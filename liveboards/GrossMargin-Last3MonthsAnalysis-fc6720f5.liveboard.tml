    note_tile:
      html_parsed_string: "<h2 class=\"theme-module__editor-h2\" dir=\"ltr\" style=\"text-align: center; color: #2E7D32; margin-bottom: 20px;\"><span style=\"white-space: pre-wrap;\">📊 Gross Margin Analysis - Q2 2026</span></h2><p class=\"theme-module__editor-paragraph\" dir=\"ltr\" style=\"text-align: center; margin-bottom: 15px;\"><span style=\"white-space: pre-wrap; font-size: 12px; color: #666;\">Generated on March 27, 2026</span></p><p class=\"theme-module__editor-paragraph\" dir=\"ltr\" style=\"margin-bottom: 20px;\"><span style=\"white-space: pre-wrap;\">🎯 <strong>Analysis Summary:</strong><br><tab>This liveboard provides a comprehensive view of your gross margin performance across the last three months (April, May, and June 2026). Each visualization shows the monthly gross margin data extracted from your Orders Raw dataset, allowing you to track profitability trends and identify patterns in your business performance.</span></p><p class=\"theme-module__editor-paragraph\" dir=\"ltr\" style=\"margin-bottom: 15px;\"><span style=\"white-space: pre-wrap;\">📈 <strong style=\"color: #1976D2;\">Key Insights:</strong><br><tab>• Monthly gross margin breakdown for Q2 2026<br><tab>• Data sourced from comprehensive order transactions<br><tab>• Filtered by specific date ranges for accurate month-over-month comparison</span></p><p class=\"theme-module__editor-paragraph\" dir=\"ltr\"><span style=\"white-space: pre-wrap;\">💡 <strong style=\"color: #F57C00;\">Use Case:</strong> Monitor profitability trends, identify seasonal patterns, and make data-driven decisions to optimize your gross margin performance.</span></p><div class=\"pinboard-note-tile-module__noteTileBg editor-module__bgNode\"></div>"
  - id: Viz_2
    answer:
      name: What is the gross margin for the month of April 2026?
      tables:
      - id: Orders Raw
        name: Orders Raw
        obj_id: OrdersRaw-f75c466a
      formulas:
      - id: formula_gross margin
        name: gross margin
        expr: "sum ( [Profit] ) / sum ( [Sales] )"
        was_auto_generated: false
      search_query: "[formula_gross margin] [Order Date] = 'april 2026'"
      answer_columns:
      - name: gross margin
      table:
        table_columns:
