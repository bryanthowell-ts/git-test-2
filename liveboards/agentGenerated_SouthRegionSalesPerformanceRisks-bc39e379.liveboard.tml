obj_id: agentGenerated_SouthRegionSalesPerformanceRisks-bc39e379
liveboard:
  name: agentGenerated_South Region Sales Performance Risks
  visualizations:
  - id: Viz_1
    viz_guid: 15ffbdd1-1996-4465-9505-7fafadc520a5
    note_tile:
      html_parsed_string: |-
        Key Drivers:
        • South region has lowest total sales at $391,722 (54% of top-performing West region)
        • Tables sub-category losing $4,623 and Machines losing $1,439, eroding regional profitability by $6,000+
        • Furniture category profit margin critically low at 5.8% vs 15.9% for Office Supplies
        • North Carolina state showing $7,491 in losses

        Recommendations:
        • Immediately review Tables and Machines pricing/cost structure to eliminate losses
        • Implement targeted sales initiatives in North Carolina to reverse $7,491 deficit
        • Focus growth efforts on higher-margin Office Supplies and Technology categories
  - id: Viz_2
    answer:
      name: Sales and Profit by Category where Region is South
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      search_query: "[Sales] [Profit] [Category] [Region] = 'south'"
      answer_columns:
      - name: Category
      - name: Total Profit
      - name: Total Sales
      table:
        table_columns:
        - column_id: Category
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Profit
          headline_aggregation: SUM
        - column_id: Total Sales
          headline_aggregation: SUM
        ordered_column_ids:
        - Category
        - Total Sales
        - Total Profit
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Category\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}}]}"
      chart:
        type: BAR
        chart_columns:
        - column_id: Category
        - column_id: Total Profit
        - column_id: Total Sales
        axis_configs:
        - x:
          - Category
          "y":
          - Total Sales
          - Total Profit
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"Total Profit\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}},{\"columnId\": \"Category\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"55ca4cbc-9b90-4a6f-84d4-62f7d018d0f9\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Sales\"],\"isOpposite\": false}},{\"id\": \"c1ea2ff8-92d4-4440-a85c-026be243055e\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Profit\"],\"isOpposite\": true}},{\"id\": \"a99bcc35-e2b5-4874-942e-8305ceb6a707\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Category\"]}}]}"
