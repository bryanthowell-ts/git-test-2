  - id: Viz_4
    answer:
      name: "Calculate profit margin as sum of Profit divided by sum of Sales by Region, sorted by profit margin ascending"
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      formulas:
      - id: formula_Profit Margin
        name: Profit Margin
        expr: "sum ( [Profit] ) / sum ( [Sales] )"
