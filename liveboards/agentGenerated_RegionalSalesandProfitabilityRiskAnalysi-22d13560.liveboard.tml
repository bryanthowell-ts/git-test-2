obj_id: agentGenerated_RegionalSalesandProfitabilityRiskAnalysi-22d13560
liveboard:
  name: agentGenerated_Regional Sales and Profitability Risk Analysis
  visualizations:
  - id: Viz_1
    viz_guid: f275184b-9cce-437f-a22f-81c8caae6b47
    note_tile:
      html_parsed_string: |-
        Key Drivers:
        • Central region profit margin only 7.9% vs 14.9% for West, with furniture category losing $2,871
        • Central region discounting at 24% (double West's rate) indicating pricing pressure
        • 2024 profit declines: Central -62%, South -50% showing deteriorating performance
        • Central has 6 product categories losing money including tables (-$3,560) and furnishings (-$3,906)

        Recommendations:
        • Immediately review Central region pricing strategy and reduce discount dependency from 24%
        • Discontinue or restructure unprofitable furniture lines in Central, especially tables and furnishings
        • Investigate South region's 2024 profit decline and implement targeted recovery plan
  - id: Viz_2
    answer:
      name: "Total Sales and Total Profit by Region, sorted by Sales descending"
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      search_query: "[Sales] [Profit] [Region] sort by [Sales] descending"
      answer_columns:
      - name: Region
      - name: Total Profit
      - name: Total Sales
        sort_info:
          category: DEFAULT
      table:
        table_columns:
        - column_id: Region
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Profit
          headline_aggregation: SUM
        - column_id: Total Sales
          headline_aggregation: SUM
        ordered_column_ids:
        - Region
        - Total Sales
        - Total Profit
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Region\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}}]}"
