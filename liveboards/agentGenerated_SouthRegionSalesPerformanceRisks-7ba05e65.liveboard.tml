obj_id: agentGenerated_SouthRegionSalesPerformanceRisks-7ba05e65
liveboard:
  name: agentGenerated_South Region Sales Performance Risks
  visualizations:
  - id: Viz_1
    viz_guid: dbedb0ea-61f0-4ae1-a83c-2916d30bcba3
    note_tile:
      html_parsed_string: |-
        Key Drivers:
        • South region has lowest sales (391,722) and orders (1,620) among all regions, 46% below top performer
        • Tables and Machines sub-categories showing negative profit margins at -10.5% and -2.7% respectively
        • High discount rates correlate with losses - Tables (22.3% discount) and Machines (33.3% discount) both unprofitable
        • Excessive discounting strategy eroding margins across multiple product lines

        Recommendations:
        • Immediately review pricing strategy for Tables and Machines - consider discontinuing or restructuring
        • Implement discount approval controls, especially for categories above 20% discount threshold
        • Focus sales efforts on profitable categories like Technology and Office Supplies with better margins
  - id: Viz_2
    answer:
      name: Sales and Profit by Sub Category where Region is South sorted by Profit ascending
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      search_query: "[Sales] [Profit] [Sub Category] [Region] = 'south' sort by [Profit]"
      answer_columns:
      - name: Sub Category
      - name: Total Profit
        sort_info:
          category: DEFAULT
      - name: Total Sales
      table:
        table_columns:
        - column_id: Sub Category
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Profit
          headline_aggregation: SUM
        - column_id: Total Sales
          headline_aggregation: SUM
        ordered_column_ids:
        - Sub Category
        - Total Sales
        - Total Profit
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Sub Category\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}}]}"
