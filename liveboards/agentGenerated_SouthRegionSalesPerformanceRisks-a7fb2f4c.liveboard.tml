obj_id: agentGenerated_SouthRegionSalesPerformanceRisks-a7fb2f4c
liveboard:
  name: agentGenerated_South Region Sales Performance Risks
  visualizations:
  - id: Viz_1
    viz_guid: 087a7801-ec6c-4265-9b85-3f1689646946
    note_tile:
      html_parsed_string: "Key Drivers:\n• South region has lowest sales at 391,722 - 46% below top-performing West region\n• Tables sub-category losing -4,623 profit, Machines losing -1,439 profit  \n• Three states operating at losses: North Carolina (-7,491), Tennessee (-5,342), Florida (-3,399)\n• Monthly profit volatility with recent losses despite maintaining sales volume\n\nRecommendations:\n• Discontinue or restructure Tables and Machines product lines in South region\n• Focus sales efforts on profitable states like Georgia while addressing loss-making state operations\n• Implement pricing optimization to improve profit margins on high-volume low-margin products"
  - id: Viz_2
    answer:
      name: Bottom 10 State by Profit where Region is South
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      search_query: "bottom 10 [State] [Region] = 'south' sort by [Profit]"
      answer_columns:
      - name: State
      - name: Total Profit
      table:
        table_columns:
        - column_id: State
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Profit
          headline_aggregation: SUM
        ordered_column_ids:
        - State
        - Total Profit
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"State\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}}]}"
      chart:
        type: BAR
        chart_columns:
        - column_id: State
        - column_id: Total Profit
        axis_configs:
        - x:
          - State
          "y":
          - Total Profit
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"Total Profit\",\"columnProperty\": {}},{\"columnId\": \"State\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"8b4217e8-22ce-485c-8bbf-6f5c490b4693\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Profit\"],\"isOpposite\": false}},{\"id\": \"a3952cdb-ea45-411c-9f26-7875227c0590\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"State\"]}}]}"
      display_mode: CHART_MODE
