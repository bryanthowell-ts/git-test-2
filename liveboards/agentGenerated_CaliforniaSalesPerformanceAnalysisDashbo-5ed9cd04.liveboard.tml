obj_id: agentGenerated_CaliforniaSalesPerformanceAnalysisDashbo-5ed9cd04
liveboard:
  name: agentGenerated_California Sales Performance Analysis Dashboard
  visualizations:
  - id: Viz_1
    viz_guid: ce56fea9-6fcf-4013-abfc-9797b9738590
    note_tile:
      html_parsed_string: |-
        Key Drivers:
        • Los Angeles and San Francisco dominate with 63% of California's $457,688 total sales
        • Tables sub-category shows $45,430 in sales but generates -$304 loss, indicating pricing/cost issues
        • Consumer segment represents 50.2% of sales, significantly outperforming corporate and home office
        • Office Supplies achieves highest profit margin at 26.5% vs Technology at 18.5%

        Recommendations:
        • Investigate Tables sub-category pricing strategy to eliminate losses while maintaining sales volume
        • Focus expansion efforts on Office Supplies given superior 26.5% profit margins
        • Strengthen presence in LA/SF markets which drive 63% of state revenue
  - id: Viz_2
    answer:
      name: Sales and Profit by Category where State is California
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      search_query: "[Sales] [Profit] [Category] [State] = 'california'"
      answer_columns:
      - name: Category
      - name: Total Profit
      - name: Total Sales
      table:
        table_columns:
        - column_id: Category
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Profit
          headline_aggregation: SUM
        - column_id: Total Sales
          headline_aggregation: SUM
        ordered_column_ids:
        - Category
        - Total Sales
        - Total Profit
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Category\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}}]}"
      chart:
        type: BAR
        chart_columns:
        - column_id: Category
        - column_id: Total Profit
        - column_id: Total Sales
        axis_configs:
        - x:
          - Category
          "y":
          - Total Sales
          - Total Profit
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"Category\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"556caff0-a8a2-4c57-8e7d-7f32ecc0a348\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Sales\"],\"isOpposite\": false}},{\"id\": \"fe1fe099-b7cf-4852-86ac-349023847855\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Profit\"],\"isOpposite\": true}},{\"id\": \"3f7ecce1-13a7-4711-a695-fa3b6df616bf\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Category\"]}}]}"
      display_mode: CHART_MODE
    viz_guid: 949e3bb0-5d3a-4ded-8399-151685115886
