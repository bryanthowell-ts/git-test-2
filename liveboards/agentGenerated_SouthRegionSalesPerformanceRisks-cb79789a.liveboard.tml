obj_id: agentGenerated_SouthRegionSalesPerformanceRisks-cb79789a
liveboard:
  name: agentGenerated_South Region Sales Performance Risks
  visualizations:
  - id: Viz_1
    viz_guid: 58fe788c-8102-4ce0-9f11-f3c3c13a5471
    note_tile:
      html_parsed_string: |-
        Key Drivers:
        • South region ranks last with only $391K sales vs $725K in West (54% performance gap)
        • Tables losing $4,623 despite $43K sales due to 22.3% discount rate
        • Machines showing 33.3% discount rate causing $1,439 losses
        • Furniture category operating at only 5.8% profit margin vs 15.9% for Office Supplies

        Recommendations:
        • Reduce discounting on Tables and Machines - cap at 15% maximum
        • Focus sales efforts on profitable Office Supplies category growth
        • Review pricing strategy for Furniture category to improve 5.8% margin
  - id: Viz_2
    answer:
      name: "Show total Sales, total Profit by Region sorted by Sales descending"
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      search_query: "sum [Sales] sum [Profit] [Region] sort by [Sales] descending"
      answer_columns:
      - name: Region
      - name: Total Profit
      - name: Total Sales
        sort_info:
          category: DEFAULT
      table:
        table_columns:
        - column_id: Region
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Profit
          headline_aggregation: SUM
        - column_id: Total Sales
          headline_aggregation: SUM
        ordered_column_ids:
        - Region
        - Total Sales
        - Total Profit
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Region\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}}]}"
      chart:
        type: ADVANCED_COLUMN
        chart_columns:
        - column_id: Region
        - column_id: Total Profit
        - column_id: Total Sales
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"Total Sales\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}},{\"columnId\": \"Region\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"1f5604f4-a369-4a10-8991-b98340595ca3\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Sales\"],\"isOpposite\": false}},{\"id\": \"e0b6158e-c1fe-418a-9f9d-afcd2d69cf87\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Profit\"],\"isOpposite\": true}},{\"id\": \"02285c6e-ff0f-42f8-98de-160f1ac6da02\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Region\"]}}]}"
        custom_chart_config:
        - key: basic
          dimensions:
          - key: x-axis
            axes:
            - type: FLAT
              column: Region
            mode: AXIS_DRIVEN
          - key: y-axis
            axes:
            - type: MERGED
              columns:
              - Total Sales
              - Total Profit
            mode: AXIS_DRIVEN
          - key: slice-with-color
            mode: AXIS_DRIVEN
          - key: trellis-by
            mode: AXIS_DRIVEN
      display_mode: TABLE_MODE
    viz_guid: d72be012-de6b-4585-a1b5-14774db9f138
