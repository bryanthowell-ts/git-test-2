obj_id: lookslikethecentralandsouthregionsarenotasprofitableasi-08380c4d
liveboard:
  name: looks like the central and south regions are not as profitable as i would like
  visualizations:
  - id: Viz_1
    viz_guid: 2bcb02d7-919f-48aa-8fd6-9c913b310320
    note_tile:
      html_parsed_string: "Key Drivers:\n• Central region's excessive discounting (24% avg) vs West (11%) is primary profitability killer\n• Five sub-categories generating $12,890 in losses: Tables (-$8,183), Machines (-$2,925), Supplies (-$660), Bookcases (-$658), Furnishings (-$464)  \n• Central has worst profit margin at 8% despite higher sales than South (12% margin)\n\nRecommendations:\n• Immediately reduce Central region discount rates from 24% to max 15% target\n• Discontinue or reprice Tables and Machines sub-categories in Central/South regions\n• Implement stricter discount approval processes for underperforming regions"
  - id: Viz_2
    answer:
      name: Average Discount by Region
      tables:
      - id: Orders Raw
        name: Orders Raw
        obj_id: OrdersRaw-f75c466a
      search_query: "average [Discount] [Region]"
      answer_columns:
      - name: Average Discount
      - name: Region
      table:
        table_columns:
        - column_id: Average Discount
          headline_aggregation: TABLE_AGGR
        - column_id: Region
          headline_aggregation: COUNT_DISTINCT
        ordered_column_ids:
        - Region
        - Average Discount
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Region\",\"columnProperty\": {}},{\"columnId\": \"Average Discount\",\"columnProperty\": {}}]}"
      chart:
        type: BAR
        chart_columns:
        - column_id: Average Discount
        - column_id: Region
        axis_configs:
        - x:
          - Region
          "y":
          - Average Discount
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"Region\",\"columnProperty\": {}},{\"columnId\": \"Average Discount\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"ab490381-8686-406e-8ae9-57eba9a08fe5\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Average Discount\"],\"isOpposite\": false}},{\"id\": \"d5c90149-5bcc-4702-b113-c313ddfebb01\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Region\"]}}]}"
      display_mode: CHART_MODE
