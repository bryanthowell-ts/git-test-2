obj_id: agentGenerated_SouthRegionSalesPerformanceRisks-850c9ac8
liveboard:
  name: agentGenerated_South Region Sales Performance Risks
  visualizations:
  - id: Viz_1
    viz_guid: 384c4657-b16f-47ce-98d9-bf25768643c0
    note_tile:
      html_parsed_string: |-
        Key Drivers:
        • South region ranks lowest in sales (391K) and orders (1,620) among all 4 regions
        • Three sub-categories losing money: Tables (-4,623 profit), Machines (-1,439), and Supplies (~0)
        • Three states operating at loss: North Carolina (-7,491), Tennessee (-5,342), Florida (-3,399)
        • High discount rates (14.7%, 2nd highest) correlating with negative margins

        Recommendations:
        • Immediately review pricing strategy for Tables and Machines sub-categories to eliminate losses
        • Focus sales efforts on profitable states while investigating cost structures in NC, TN, FL
        • Reduce discount levels and implement margin-based incentives for sales team
  - id: Viz_2
    answer:
      name: "Total Sales, Total Profit by Segment where Region is South"
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      search_query: "[Sales] [Profit] [Segment] [Region] = 'south'"
      answer_columns:
      - name: Segment
      - name: Total Profit
      - name: Total Sales
      table:
        table_columns:
        - column_id: Segment
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Profit
          headline_aggregation: SUM
        - column_id: Total Sales
