obj_id: agentGenerated_SouthRegionSalesRiskAnalysis-2035ac1e
liveboard:
  name: agentGenerated_South Region Sales Risk Analysis
  visualizations:
  - id: Viz_1
    viz_guid: 5bd084a1-bd14-4514-8345-b304c63ca258
    note_tile:
      html_parsed_string: |-
        Key Drivers:
        • South region ranks last with 46% lower sales and 57% lower profit vs top regions
        • 2024 profit collapsed 50% despite 31% sales growth - margin dropped from 18.9% to 7.2%
        • Furniture category bleeding with only 5.8% profit margin
        • Tables and Machines subcategories losing money with 22-33% average discounts

        Recommendations:
        • Immediate pricing review and discount controls for Tables/Machines subcategories
        • Restructure Furniture pricing strategy to improve 5.8% margin
        • Investigate 2024 cost structure driving margin collapse
  - id: Viz_2
    answer:
      name: Compare total Sales and total Profit by Region to see how South region compares to other regions
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      search_query: "[Sales] [Profit] [Region]"
      answer_columns:
      - name: Region
      - name: Total Profit
      - name: Total Sales
      table:
        table_columns:
        - column_id: Region
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Profit
          headline_aggregation: SUM
        - column_id: Total Sales
          headline_aggregation: SUM
        ordered_column_ids:
        - Region
        - Total Sales
        - Total Profit
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Region\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}}]}"
      chart:
        type: COLUMN
        chart_columns:
        - column_id: Region
        - column_id: Total Profit
        - column_id: Total Sales
        axis_configs:
        - x:
          - Region
          "y":
          - Total Sales
          - Total Profit
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"Total Sales\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}},{\"columnId\": \"Region\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"42a96142-8cd6-420e-9150-0ed0eead1005\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Sales\"],\"isOpposite\": false}},{\"id\": \"fea47b31-6a21-4ede-b033-5fe7b787cd91\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Profit\"],\"isOpposite\": true}},{\"id\": \"8401d7bb-8ab2-44cc-91c0-624491bcdb11\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Region\"]}}]}"
      display_mode: CHART_MODE
    viz_guid: 016f9d91-1cb5-49e4-8bad-cf3e67e00a6f
  - id: Viz_3
    answer:
      name: "Total Sales, total Profit, average Discount by Sub Category where Region is South sorted by Profit ascending"
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      search_query: "sum [Sales] sum [Profit] average [Discount] [Sub Category] [Region] = 'south' sort by [Profit]"
      answer_columns:
      - name: Average Discount
      - name: Sub Category
      - name: Total Profit
        sort_info:
          category: DEFAULT
      - name: Total Sales
      table:
        table_columns:
        - column_id: Average Discount
          headline_aggregation: TABLE_AGGR
        - column_id: Sub Category
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Profit
          headline_aggregation: SUM
        - column_id: Total Sales
          headline_aggregation: SUM
        ordered_column_ids:
        - Sub Category
        - Total Sales
        - Total Profit
        - Average Discount
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Sub Category\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}},{\"columnId\": \"Average Discount\",\"columnProperty\": {}}]}"
