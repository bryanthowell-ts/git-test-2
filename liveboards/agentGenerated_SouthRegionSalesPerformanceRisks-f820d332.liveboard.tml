obj_id: agentGenerated_SouthRegionSalesPerformanceRisks-f820d332
liveboard:
  name: agentGenerated_South Region Sales Performance Risks
  visualizations:
  - id: Viz_1
    viz_guid: 4c3646be-55f2-47a4-869c-bf2937c6d9d2
    note_tile:
      html_parsed_string: |-
        Key Drivers:
        • South region ranks last in sales ($391,722) among all 4 regions with 11.93% profit margin
        • Tables sub-category shows -10.5% profit margin despite $43,916 in sales volume
        • Three states operate at losses: North Carolina (-13.5%), Tennessee (-17.4%), Florida (-3.8%)
        • Machines category has excessive 33.3% discount rate destroying profitability

        Recommendations:
        • Immediately review pricing strategy for Tables and reduce Machines discount rate below 25%
        • Implement targeted profit recovery plans for NC, TN, and FL loss-making states
        • Benchmark South region practices against top-performing regions to identify gaps
  - id: Viz_2
    answer:
