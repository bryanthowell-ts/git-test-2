obj_id: BannerTest4-a1b56faf
liveboard:
  name: Banner Test 4
  visualizations:
  - id: Viz_1
    viz_guid: 67f85323-6336-4fac-b7c8-162e06bb21a3
    note_tile:
      html_parsed_string: |-
        Key Drivers:
        • West region leads with $725,458 sales and highest profit margin at 14.9%
        • Central region shows poor profitability at 7.9% margin despite $501,240 in sales
        • East region delivers strong volume ($678,781) but lower 13.5% profit margin
        • South region maintains 11.9% margin with lowest sales volume at $391,722

        Recommendations:
        • Investigate Central region's cost structure and discounting practices to improve 7.9% margin
        • Expand successful West region strategies to other territories
        • Focus growth investments on high-margin West and East regions
  - id: Viz_2
