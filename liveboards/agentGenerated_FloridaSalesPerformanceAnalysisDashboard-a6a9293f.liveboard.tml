obj_id: agentGenerated_FloridaSalesPerformanceAnalysisDashboard-a6a9293f
liveboard:
  name: agentGenerated_Florida Sales Performance Analysis Dashboard
  visualizations:
  - id: Viz_1
    viz_guid: f4304864-58f1-4c05-9bf4-b0cbd0319ace
    note_tile:
      html_parsed_string: |-
        Key Drivers:
        • Florida operates at -3.8% profit margin with $3,399 net loss despite $89,474 in sales
        • Furniture category drives biggest losses at -$2,255 with -9.8% margin
        • Office Supplies also unprofitable at -$1,675 with -8.6% margin
        • All customer segments (Home Office, Consumer, Corporate) show negative profitability

        Recommendations:
        • Focus growth strategy on Technology category - only profitable segment with +1.1% margin
        • Review pricing and cost structure for Furniture and Office Supplies categories immediately
        • Concentrate sales efforts in Jacksonville which generates 44% of state revenue
  - id: Viz_2
    answer:
      name: "Total Sales, Total Profit, Total Quantity where State is Florida"
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      search_query: "[Sales] [Profit] [Quantity] [State] = 'florida'"
      answer_columns:
      - name: Total Profit
      - name: Total Quantity
      - name: Total Sales
      table:
        table_columns:
        - column_id: Total Profit
          headline_aggregation: SUM
        - column_id: Total Quantity
          headline_aggregation: SUM
        - column_id: Total Sales
          headline_aggregation: SUM
        ordered_column_ids:
        - Total Sales
        - Total Profit
        - Total Quantity
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Total Sales\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}},{\"columnId\": \"Total Quantity\",\"columnProperty\": {}}]}"
      chart:
        type: KPI
        chart_columns:
        - column_id: Total Profit
        - column_id: Total Quantity
        - column_id: Total Sales
        axis_configs:
        - "y":
          - Total Sales
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"Total Sales\",\"columnProperty\": {}},{\"columnId\": \"Total Profit\",\"columnProperty\": {}},{\"columnId\": \"Total Quantity\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"381a0998-b454-447e-91bc-58230a8b8923\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Sales\"],\"isOpposite\": false}},{\"id\": \"02906214-5ec6-4c16-bfbe-42245d986b9f\",\"properties\": {\"axisType\": \"X\"}}]}"
