obj_id: agentGenerated_CentralRegionLowProfitContributors-92e35250
liveboard:
  name: agentGenerated_Central Region Low Profit Contributors
  visualizations:
  - id: Viz_1
    viz_guid: aedf8d53-79dc-4b87-9aaf-ae0760ee8f18
    note_tile:
      html_parsed_string: |-
        Key Drivers:
        • West region generates highest sales (725K) and profit (108K) with 14.9% margin
        • Central region shows poor efficiency with lowest profit margin at 7.9% despite 501K sales
        • East region maintains strong 13.5% profit margin on 679K sales
        • South region achieves better profitability (11.9% margin) than Central despite lower sales volume

        Recommendations:
        • Investigate Central region's cost structure and pricing to improve 7.9% margin
        • Replicate West region's successful strategies across other territories
        • Focus growth investments in high-performing West and East regions
  - id: Viz_2
    answer:
      name: Profit by Category where Region is Central
      tables:
      - id: RAD Superstore
        name: RAD Superstore
        obj_id: RADSuperstoreProd
      search_query: "[Profit] [Category] [Region] = 'central'"
      answer_columns:
