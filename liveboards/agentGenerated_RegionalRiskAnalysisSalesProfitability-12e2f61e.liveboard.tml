obj_id: agentGenerated_RegionalRiskAnalysisSalesProfitability-12e2f61e
liveboard:
  name: agentGenerated_Regional Risk Analysis Sales Profitability
  visualizations:
  - id: Viz_1
    viz_guid: a2b0d87d-a6fd-47d7-a350-48a6ea1632db
    note_tile:
      html_parsed_string: |-
        Key Drivers:
        • Central region shows lowest profitability at 39,706 units vs 108,418 for West (63% lower)
        • Furniture category operates at -2,871 units loss in Central region only
        • Central region has highest discount rates at 24.0% vs 10.9% in West
        • Excessive discounting in Furniture (29.7%) and Office Supplies (25.3%) eroding margins

        Recommendations:
        • Implement immediate discount controls in Central region, targeting 15% maximum
        • Review Furniture category pricing strategy and supplier costs in Central region
        • Increase focus on Technology sales in Central where discount rates are normal
  - id: Viz_2
